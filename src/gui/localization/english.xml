      <Item id="phase_starting" name="Preparing the curve"/>
      <Item id="phase_calibration" name="Short startup calibration"/>
      <Item id="phase_read" name="Read and validate save"/>
      <Item id="phase_read_detail" name="Read the selected Stage1 point, verify its save record against the planned fingerprint, and reject changed or malformed input."/>
      <Item id="phase_plan" name="Plan bounds and memory"/>
      <Item id="phase_plan_detail" name="Choose D under B2, device, and memory constraints; derive P=phi(D)/2, giant-point count, G-tree batches, and polynomial workspace."/>
      <Item id="phase_baby" name="Generate and normalize baby points"/>
      <Item id="phase_baby_detail" name="Compute [j]Q for indices j coprime to D, classify noninvertible coordinates, and batch-normalize to affine x_j."/>
      <Item id="phase_ftree" name="Build F tree"/>
      <Item id="phase_ftree_detail" name="Multiply the X-x_j leaves into F(X), retaining subtree polynomials needed for multipoint evaluation."/>
      <Item id="phase_inverse" name="Prepare polynomial inverse"/>
      <Item id="phase_inverse_detail" name="Use Newton iteration to compute the truncated inverse of reversed F; reuse it for reduction modulo F and descent-root setup."/>
      <Item id="phase_giant" name="Giant points, G trees and fold"/>
      <Item id="phase_giant_detail" name="Generate [iD]Q in batches, build each G product tree, and accumulate H=G*H mod F. Point generation, tree construction, and folding interleave."/>
      <Item id="phase_descent" name="Normalize fold and descend F tree"/>
      <Item id="phase_descent_detail" name="Undo the projective scale Gamma, prepare the scaled root, and descend the F tree to obtain H(x_j) at each baby root."/>
      <Item id="phase_gcd" name="Leaf products and GCD"/>
      <Item id="phase_gcd_detail" name="Multiply H(x_j) in blocks, take GCDs with target N, then refine hit blocks and validate factors."/>
      <Item id="phase_check" name="Validate arithmetic"/>
      <Item id="phase_factor" name="Factor decomposition"/>
      <Item id="phase_publish" name="Publish result"/>
      <Item id="phase_curve_done" name="Curve completed"/>
      <Item id="phase_done" name="Task completed"/>
    </Panel>
