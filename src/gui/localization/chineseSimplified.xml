    <Panel id="exit">
      <Item id="confirm_mixed" name="%d个worker仍在运行。保存Stage1检查点并完成各自当前Stage2曲线后退出？"/>
      <Item id="waiting_mixed" name="等待Stage1检查点及当前Stage2曲线完成（最多剩余%lld秒）…"/>
      <Item id="confirm_stage1" name="%d个worker仍在运行。保存Stage1检查点后退出？"/>
      <Item id="confirm_stage2" name="%d个worker仍在运行。等待各自当前Stage2曲线完成后退出？"/>
      <Item id="stop_quit" name="停止并退出"/>
      <Item id="cancel" name="取消"/>
      <Item id="stopping_title" name="正在停止worker"/>
      <Item id="waiting_stage1" name="等待Stage1写检查点并退出（最多剩余%lld秒）…"/>
      <Item id="waiting_stage2" name="等待当前Stage2曲线完成并退出（最多剩余%lld秒）…"/>
      <Item id="force_quit" name="强制退出（丢弃未完成计算）"/>
    </Panel>
  </Native-Langue>
</EcmGui>
