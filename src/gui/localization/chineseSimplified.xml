      <Item id="col_lines"      name="行数"/>
      <Item id="col_segments"   name="worker 段数"/>
      <Item id="col_dup"        name="去除重复"/>
      <Item id="col_skipped"    name="跳过"/>
      <Item id="errors"         name="被跳过的输入行与警告："/>
      <Item id="recommended_note" name="推荐曲线数 = Block/SM × SM × TPB (128) / TPI  (--gpu-info); 已消去已知因子"/>
    </Panel>

    <Panel id="p95">
      <Item id="not_configured"  name="Prime95 交付已关闭：ecm.ini 缺少设置 『p95_worktodo_path』 或 『p95_add_workers』"/>
      <Item id="open_ini"        name="打开 ecm.ini"/>
      <Item id="ready"           name="Prime95 交付就绪：完成的 Stage1 任务将追加到 worktodo.add"/>
      <Item id="ok"              name="Prime95 交付成功：完成任务成功追加到 worktodo.add"/>
      <Item id="warn"            name="Prime95 交付警告"/>
      <Item id="pending"         name="Prime95 交付失败：%d 行待追加，会在下次成功交付时一起送出"/>
      <Item id="open_dir"        name="打开 Prime95 目录"/>
      <Item id="open_pending"    name="打开待追加文件（可能为空）"/>
    </Panel>

    <Panel id="workers">
      <Item id="default_engine" name="默认阶段"/>
      <Item id="worker_count" name="Worker 数量"/>
      <Item id="inherit_engine" name="继承 [GUI] stage；修改此行只重配该已停止 worker。"/>
      <Item id="engine" name="计算阶段"/>
      <Item id="engine_auto" name="自动"/>
      <Item id="choose_exe" name="选择程序…"/>
      <Item id="choose_ini" name="选择INI…"/>
      <Item id="configuration_selected" name="已选择配置"/>
      <Item id="known_factors" name="已知因子"/>
