      <Item id="phase_calibration" name="启动短校准"/>
      <Item id="phase_read" name="读取并验证存档"/>
      <Item id="phase_plan" name="规划边界与显存"/>
      <Item id="phase_baby" name="生成并归一化baby点"/>
      <Item id="phase_ftree" name="构建F树"/>
      <Item id="phase_inverse" name="准备多项式逆"/>
