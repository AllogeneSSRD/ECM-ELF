    <Panel id="detail">
      <Item id="title"            name="详情"/>
      <Item id="effective_config" name="生效配置（段内键覆盖全局键）："/>
      <Item id="task_line"        name="worktodo 行"/>
      <Item id="command_line"     name="命令行"/>
    </Panel>

    <Panel id="results">
      <Item id="title"       name="结果"/>
      <Item id="rebuild"     name="从 JSONL 重建 results.txt"/>
      <Item id="open_folder" name="打开 results.txt"/>
      <Item id="bits"        name="bits"/>
      <Item id="empty"       name="未发现因子，此处统计所有 worker 的结果"/>
      <Item id="json_file"   name="原始记录"/>
      <Item id="factor"      name="因子"/>
      <Item id="curves"      name="曲线"/>
      <Item id="sigmas"      name="sigma 列表"/>
      <Item id="hits"        name="命中次数"/>
      <Item id="first_seen"  name="首次命中"/>
    </Panel>

    <Panel id="stage2">
      <Item id="phase" name="阶段"/>
      <Item id="curve" name="曲线"/>
      <Item id="batch" name="巨步批次"/>
      <Item id="phase_remaining" name="当前阶段剩余（估计）"/>
      <Item id="finish_curve_stop" name="正在等待当前曲线完成后停止。"/>
      <Item id="notice" name="Stage1存档 → 多项式Stage2 → GCD  |  运行中的worker：%d / %d"/>
