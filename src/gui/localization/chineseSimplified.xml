      <Item id="col_task"     name="当前任务"/>
      <Item id="col_progress" name="进度"/>
      <Item id="col_speed"    name="速度"/>
      <Item id="col_eta"      name="剩余"/>
      <Item id="col_hits"     name="命中"/>
      <Item id="col_actions"  name="操作"/>
      <Item id="waiting_progress" name="等待第一行进度信息"/>
      <Item id="resume_note" name="从检查点继续，等待下一行日志（更新间隔不超过 10 秒）。"/>
      <Item id="start"        name="启动"/>
      <Item id="stop"         name="停止"/>
      <Item id="start_all"    name="全部启动"/>
      <Item id="stop_all"     name="全部停止"/>
      <Item id="exe"          name="工作进程："/>
      <Item id="show_raw"     name="原始输出"/>
      <Item id="speed_history" name="秒/曲线（越小越快）"/>
      <Item id="collecting"    name="正在采集…"/>
      <Item id="m2_note" name="每个worker管理一个计算程序。停止会请求安全退出；反复失败后停止自动重启。"/>
      <Item id="log_pane"     name="输出"/>
      <Item id="log_file"     name="日志文件"/>
      <Item id="open_saves"   name="打开存档目录"/>
      <Item id="no_output"    name="暂无输出"/>
      <Item id="m1_note"      name="Worker 由 ecm.ini 配置。进程管理、实时输出和重启限制见 docs/usage/GUI.md。"/>
      <Item id="duplicate_device" name="有另一个 worker 用了同一张 GPU 。"/>
      <Item id="state_stopped"    name="已停止"/>
      <Item id="state_starting"   name="启动中"/>
      <Item id="state_running"    name="运行中"/>
      <Item id="state_restarting" name="重启中"/>
      <Item id="state_error"      name="错误"/>
      <Item id="state_queue_empty" name="队列已空"/>
    </Panel>

    <Panel id="gpu">
      <Item id="title"    name="GPU"/>
      <Item id="util"     name="占用率"/>
      <Item id="power"    name="功耗"/>
      <Item id="clock_sm" name="频率"/>
      <Item id="clock_mem" name="显存频率"/>
      <Item id="temp"     name="温度"/>
      <Item id="memory"   name="显存"/>
      <Item id="throttle" name="节流"/>
      <Item id="cores"    name="CUDA"/>
      <Item id="poll"     name="NVML 采样间隔"/>
      <Item id="refresh"  name="界面刷新"/>
      <Item id="m4_note"  name="由后台线程经 NVML 采样"/>
