<?xml version="1.0" encoding="utf-8" ?>
<!--
  ecm_gui 界面文案 —— 简体中文。
  与 localization/english.xml 一一对应：缺哪个键就自动回退英文（不会出现空文本）。
  欢迎直接改这个文件（或复制它做别的语言），改完在 GUI 里点 Language -> Reload localization 即可生效。
  编码必须是 UTF-8（可带/不带 BOM）；非 UTF-8 会在 GUI 里报错而不是显示乱码。
-->
<EcmGui>
  <Native-Langue name="简体中文" filename="chineseSimplified.xml" version="1">

    <Panel id="menu">
      <Item id="file"              name="文件"/>
      <Item id="view"              name="视图"/>
      <Item id="language"          name="语言"/>
      <Item id="tools"             name="工具"/>
      <Item id="open_ini"          name="打开 ecm.ini 所在目录"/>
      <Item id="open_localization" name="打开 本地化目录"/>
      <Item id="save_settings"     name="立即保存布局与设置"/>
      <Item id="reload_localization" name="重新载入本地化"/>
      <Item id="start_all"         name="启动全部 Worker 进程"/>
      <Item id="stop_all"          name="停止全部 Worker 进程"/>
      <Item id="quit"              name="退出"/>
    </Panel>

    <Panel id="gen">
      <Item id="target_worker" name="队列目标 worker"/>
      <Item id="title"          name="生成器"/>
      <Item id="paste_hint"     name="输入 PrimeNet 任务「ECM= / ECM2= 」或打开文件；忽略 # 开头的注释行"/>
      <Item id="load_file"      name="打开文件…"/>
      <Item id="curve_options"  name="曲线选项"/>
      <Item id="output_options" name="输出选项"/>
      <Item id="use_recommended" name="使用推荐曲线数"/>
      <Item id="blocks_per_sm"  name="块/SM"/>
      <Item id="dedup"          name="去重"/>
      <Item id="override_b1"    name="覆盖 B1"/>
      <Item id="override_b1_hint" name="留空保持原值"/>
      <Item id="save_pattern"   name="存档名"/>
      <Item id="sort_by"        name="排序"/>
      <Item id="sort_none"      name="按输入顺序"/>
      <Item id="target_device"  name="目标 GPU "/>
      <Item id="preview"        name="生成预览"/>
      <Item id="apply"          name="追加到 worktodo"/>
      <Item id="target"         name="目标文件："/>
      <Item id="preview_ready"  name="预览已生成，尚未写入，点击「追加到 worktodo」"/>
      <Item id="no_preview"     name="预览为空"/>
      <Item id="applied"        name="追加成功"/>
