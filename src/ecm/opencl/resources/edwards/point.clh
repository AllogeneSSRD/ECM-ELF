// Extended Edwards a=1. A dictionary entry stores d*T in its fourth field.
typedef struct { fe x, y, z, t; } ed_point;

EDWARDS_INLINE ed_point ed_double(ed_point p, fe n, uint np0, int need_t, int two_xy) {
    const fe a = fe_sqr(p.x, n, np0);
    const fe b = fe_sqr(p.y, n, np0);
    const fe z2 = fe_sqr(p.z, n, np0);
    fe e;
    if (two_xy) {
        const fe xy = fe_mul(p.x, p.y, n, np0);
        e = fe_add(xy, xy, n);
    } else {
        const fe xy = fe_add(p.x, p.y, n);
        e = fe_sub(fe_sub(fe_sqr(xy, n, np0), a, n), b, n);
    }
    const fe g = fe_add(a, b, n);
    const fe f = fe_sub(g, fe_add(z2, z2, n), n);
    const fe h = fe_sub(a, b, n);
    p.x = fe_mul(e, f, n, np0);
    p.y = fe_mul(g, h, n, np0);
    p.z = fe_mul(f, g, n, np0);
    if (need_t)
        p.t = fe_mul(e, h, n, np0);
    return p;
}

EDWARDS_INLINE ed_point ed_add(ed_point p, ed_point q, fe n, uint np0, int need_t) {
    const fe a = fe_mul(p.x, q.x, n, np0);
    const fe b = fe_mul(p.y, q.y, n, np0);
    const fe c = fe_mul(p.t, q.t, n, np0);
    const fe d = fe_mul(p.z, q.z, n, np0);
    const fe cross = fe_mul(fe_add(p.x, p.y, n), fe_add(q.x, q.y, n), n, np0);
    const fe e = fe_sub(fe_sub(cross, a, n), b, n);
    const fe f = fe_sub(d, c, n);
    const fe g = fe_add(d, c, n);
    const fe h = fe_sub(b, a, n);
    p.x = fe_mul(e, f, n, np0);
    p.y = fe_mul(g, h, n, np0);
    p.z = fe_mul(f, g, n, np0);
    if (need_t)
        p.t = fe_mul(e, h, n, np0);
    return p;
}

EDWARDS_INLINE ed_point point_load(__global const uint *p, size_t stride) {
    const ed_point point = {fe_load(p, stride), fe_load(p + LIMBS * stride, stride),
                            fe_load(p + 2 * LIMBS * stride, stride),
                            fe_load(p + 3 * LIMBS * stride, stride)};
    return point;
}

EDWARDS_INLINE void point_store(__global uint *p, size_t stride, ed_point q) {
    fe_store(p, stride, q.x);
    fe_store(p + LIMBS * stride, stride, q.y);
    fe_store(p + 2 * LIMBS * stride, stride, q.z);
    fe_store(p + 3 * LIMBS * stride, stride, q.t);
}
