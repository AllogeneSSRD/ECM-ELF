      <Item id="phase_calibration" name="启动短校准"/>
      <Item id="phase_read" name="读取并校验 Stage1 存档"/>
      <Item id="phase_read_detail" name="读取当前曲线的 Stage1 点记录，核对存档内容与规划时的指纹，拒绝已变化或损坏的输入。"/>
      <Item id="phase_plan" name="规划 D、P 与内存"/>
      <Item id="phase_plan_detail" name="结合 B2、内存限制选择步长 D；计算 Baby point 数 P=φ(D)/2、Giant point数、G 树批次及多项式工作区。"/>
      <Item id="phase_baby" name="生成并归一化 Baby point "/>
      <Item id="phase_baby_detail" name="对与 D 互素的索引 j 计算 [j]Q，检查不可逆坐标并批量求逆，得到仿射横坐标 x_j。"/>
      <Item id="phase_ftree" name="构建 F 乘积树"/>
      <Item id="phase_ftree_detail" name="以 X−x_j 为叶逐层相乘，构造 F(X)=∏(X−x_j)，并保留后续多点求值所需的子树。"/>
      <Item id="phase_inverse" name="预计算反转 F 的截断逆"/>
      <Item id="phase_inverse_detail" name="用 Newton 迭代求反转 F 的截断逆 finv，供多次模 F 归约及下降根准备复用。"/>
      <Item id="phase_giant" name="Giant point、G 乘积树与模 F 折叠"/>
      <Item id="phase_giant_detail" name="分批生成 [iD]Q，构造每批的 G 乘积树，再以 H←G·H mod F 累积各批结果；点生成、建树和折叠交织执行。"/>
      <Item id="phase_descent" name="校正缩放并沿 F 树下降"/>
      <Item id="phase_descent_detail" name="消除齐次大步叶引入的 Γ 缩放，形成缩放表示的下降根，沿 F 子树传播余式，得到各小步根上的 H(x_j)。"/>
      <Item id="phase_gcd" name="叶值分块求积与 GCD"/>
      <Item id="phase_gcd_detail" name="将 H(x_j) 按块相乘，并与目标 N 求最大公因数；对命中块继续细分并验证因子。"/>
      <Item id="phase_check" name="算术检查"/>
      <Item id="phase_factor" name="因子分解"/>
      <Item id="phase_publish" name="发布结果"/>
      <Item id="phase_curve_done" name="曲线已完成"/>
      <Item id="phase_done" name="任务已完成"/>
