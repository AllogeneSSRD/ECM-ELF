// Capacity, not a CGBN container. Arithmetic and Montgomery radix use actual W.
#ifndef ECM_CUDA_STAGE2_CAPACITIES
#define ECM_CUDA_STAGE2_CAPACITIES(ROW,FN,...) \
    ROW(4,FN,__VA_ARGS__) ROW(8,FN,__VA_ARGS__) ROW(16,FN,__VA_ARGS__) \
    ROW(32,FN,__VA_ARGS__) ROW(64,FN,__VA_ARGS__) ROW(128,FN,__VA_ARGS__) ROW(256,FN,__VA_ARGS__)
#endif

// Explicit PRAC policy geometry; separate from the default CGBN TPI mapping.
// mode_family values are descriptive, not persistent algorithm/domain IDs.
#ifdef ECM_CUDA_PRAC_VARIANT
ECM_CUDA_PRAC_VARIANT(2560,32,alternate)
ECM_CUDA_PRAC_VARIANT(4608,32,alternate)
ECM_CUDA_PRAC_VARIANT(4608,16,special_registers)
ECM_CUDA_PRAC_VARIANT(4608,32,single_compact)
#endif
