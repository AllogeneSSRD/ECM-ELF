tools/bench/plan_auto_b2.py text eol=lf
tools/bench/validate_ecm_costs.py text eol=lf
tools/bench/audit_ecm_costs.py text eol=lf
docs/data/ecm_auto_b2_phase_20261005* -text
docs/data/ecm_factor_only_20261005* -text
docs/data/ecm_phase_20261005* -text
docs/data/ecm_phase_nsys_20261005* -text
docs/data/ecm_phase_ncu_20261005* -text
