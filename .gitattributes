# C/C++ 强制文本
*.c text diff
*.cpp text diff
*.h text diff
*.py text diff
*.md text diff

# 可选：统一换行（跨平台）
# Auto detect text files and perform LF normalization
* text=auto

# Dataset snapshots include SHA256 of their raw bytes; checkout must preserve
# their line endings, including CSV CRLF and JSONL LF.
data/ecm_stage2_snapshot_20261005/** -text
tools/ecm_dataset/*.sqlite -text -diff

# New cost-model modules and published evidence are SHA-fingerprinted.
tools/bench/ecm_cost_model.py text eol=lf
tools/bench/fit_ecm_costs.py text eol=lf
