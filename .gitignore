logs/
docs/ecm/
test/bench

# build
build/
# tools/build holds parallel_nvcc.ps1 (the parallel CUDA compile driver), so the bare
# "build/" rule above must not swallow that directory.
!/tools/build/
build_rel/
build_cuda/*
!build_cuda/*.bat
build_cuda_cmake/
/build_vs18

release/

**/__pycache__/
*.save
*-*signature.txt

.tmp*

# CGBN
cgbn/

# CPU edwards stage1 Z/2×Z/8
ecm_edwards_cpu.obj
*.obj
*.dll
*.exe
src/cpu/*.dll
src/cpu/*.exe
/test_edwards

# Android Studio apk
Android/ECM/app/debug/
Android/ECM/app/release/

# log
tools/log_parser/example

# ECM report database & downloaded HTML
tools/ecm_report/html/
tools/ecm_report/example/
tools/ecm_report/*.db*
# tools/ecm_report/*.png
tools/ecm_report/*.html
tools/ecm_report/*.bat
tools/ecm_report/*.png

# ECM prob
tools/ecm_prob/out
tools/ecm_prob/data
tools/ecm_prob/*.exe

# tools/ scratch (test/bench sandboxes and built helpers)
tools/bench/_abtest/
tools/bench/_speed_*.exe
tools/test/_feeder_scratch/
tools/test/fixtures/_test_*.save
tools/test/*.exe
tools/refactor/*.exe
tools/gen/__pycache__/

# Locally rebuilt GMP with x86_64/zen3 (BMI2+ADX) mpn kernels.
# Regenerate with third_party/build_gmp_zen3.sh; CMake auto-detects
# third_party/gmp-zen3/dist and falls back to vcpkg GMP when absent.
/third_party/gmp-zen3/
/third_party/zen3_runtime/

# Local Edwards stage-1 saves written by ecm.exe (e{n:07d}_c{curve:06d}[.tmp]);
# they are consumed by ecm_p95feeder. See docs/ECM_EDWARDS_STAGE1.md §11.
/e[0-9][0-9][0-9][0-9][0-9][0-9][0-9]*
/saves/
/feeder.ini
/feeder.log


/tools/test/_m3_gmp
/tools/test/_m3_simd
/tools/test/_m3f_gmp
/tools/test/_m3f_simd
# tools/test holds the acceptance/regression scripts this project actually relies on
# (test_cuda_param0.ps1 18 checks, test_cuda_param2.ps1 7 checks, test_cli_args.ps1, ...).
# The blanket "/tools/test" rule kept them out of version control entirely, so they are
# re-included here and only the "_"-prefixed scratch directories stay ignored.
!/tools/test/
/tools/test/_*
/.bench_tmp
/test_edwards-1
/tools/stat/_run
/build_cuda_dev
/build_t16
/build_jom
/build_ninja
/build_nm16
