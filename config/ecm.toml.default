# GENERATED from config/ecm_options.json / 由 config/ecm_options.json 生成
# ECM_TOML_REFERENCE.en.md lists advanced settings and worker overrides.
# 高级设置和 worker 覆盖见 ECM_TOML_REFERENCE.zh-CN.md。
config_version = 4

[shared]
# log_file = "ecm.log"  # string: <path>
# Shared run log. Relative paths use the configuration directory. An empty string disables file
# logging.
# 共用运行日志。相对路径基于配置目录。空字符串关闭文件日志。

# finished_file = "worktodo.finished.txt"  # string: <path>
# Shared completed-work file for both stages. Relative paths use the configuration directory.
# 两阶段共用的完成记录。相对路径基于配置目录。

# log_file_max_kb = 10000  # u64: [1000..1000000]
# Rotate the shared run log after its size exceeds this limit. 1 KB is 1000 bytes.
# 共享运行日志超过此上限后归档。1 KB 等于 1000 字节。

# tune_file = "tune.toml"  # string: <path>
# CUDA Stage1, CUDA Stage2 and CPU GWNUM Stage2 share this file. Defaults to tune.toml beside
# ecm.toml. Workers can override the path. An explicit empty value disables automatic persistence.
# CUDA Stage1、CUDA Stage2 和 CPU GWNUM Stage2 共用此文件，默认使用 ecm.toml 同目录的 tune.toml。
# worker 可覆盖路径。显式留空时关闭自动持久化。

worktodo_file = "worktodo.txt"  # string: <path>
# Shared queue. ECM, ECM2 and ECMSTAGE1 select Stage1; ECMSTAGE2 and ECMSTAGE2N select Stage2. One
# process consumes a worker queue at a time.
# 共用队列。ECM、ECM2 和 ECMSTAGE1 交给 Stage1，ECMSTAGE2 和 ECMSTAGE2N 交给 Stage2。同一 worker 同
# 时由一个进程消费队列。

# queue_order = "file_order"  # string: [file_order|stage1_first|stage2_first]
# file_order follows the queue. stage1_first or stage2_first runs the preferred stage until it has
# no remaining tasks, then selects the other stage.
# file_order 按文件顺序选任务。stage1_first 和 stage2_first 优先执行对应阶段，直到该阶段没有剩余任
# 务。

# queue_skip = "none"  # string: [none|stage1|stage2]
# none allows both stages. stage1 or stage2 leaves that stage's tasks in the queue.
# none 允许两阶段执行。stage1 和 stage2 将对应阶段的任务留在队列中。

# user = ""  # string: <local-user-id>
# Optional local result user identity for Stage1 and Stage2. Never put real account values in
# committed templates or fixtures.
# Stage1与Stage2结果的可选本地用户标识；真实账号值不得写入提交的模板或测试样本。

# computer = ""  # string: <local-computer-name>
# Optional local computer name in result output. Keep configured values and generated results
# outside public Git commits.
# 结果输出的可选本地计算机名；实际配置值及生成结果不得进入公共Git提交。

[stage1]
# param = "auto"  # string: [auto|e|m0|m2|m3]
# Stage1 curve construction. With auto, queue tasks default to Edwards and direct input defaults to
# m0 on CPU or m3 on GPU. The optional curve key applies with auto. A typed ECMSTAGE1 save name
# takes precedence.
# Stage1 曲线构造。auto 时，队列任务默认用 Edwards，直接输入在 CPU 上默认用 m0，在 GPU 上默认用 m3。
# curve 可在 auto 时指定曲线。ECMSTAGE1 的存档类型前缀优先。

# handoff_mode = "ecm-elf"  # string: [off|ecm-elf|prime95]
# Send successful Stage1 tasks with usable points and no factor to ECM-ELF Stage2 by default. Append
# the new task at the end of the source worker's queue unless a receiver is configured. Use off to
# keep the save or prime95 to select Prime95.
# Stage1 无因子完成且有可用保存点时，默认在原 worker 队列末尾追加 ECM-ELF Stage2 任务。可配置其他接
# 收方。off 只保留存档，prime95 交给 Prime95。

stage1_save_dir = "."  # string: <path>
# Output directory for Stage1 curve saves. Stage2 also searches here when stage2_save_dir is unset.
# This is not a Stage2 RAM or VRAM budget.
# 指定 Stage1 曲线存档的输出目录。Stage2 未设置 stage2_save_dir 时也在此目录查找任务引用的 save；此
# 键不是 Stage2 全部临时显存或内存的预算。

# cuda_slice_depth = 3  # int: [2|3|8]
# CUDA CGBN Stage1 slice submission. Values 2 and 3 keep a rolling queue of up to that many slices.
# Value 8 waits at the end of each group of up to eight.
# CUDA CGBN Stage1 的切片提交方式。2 和 3 分别滚动提交至多两片和三片。8 按最多八片一组等待组尾。

# cuda_low_cpu = false  # bool: [false|true|0|1]
# Set to 1 or true to put the CUDA CGBN Stage1 host thread to sleep while waiting for GPU
# completions, regardless of slice depth. This mode is intended to reduce host CPU use and may
# increase wake-up latency.
# 设为 1 或 true 后，CUDA CGBN Stage1 主机线程在等待 GPU 完成时休眠，对所有切片深度优先生效。此模式
# 用于降低 CPU 占用，唤醒可能稍慢。

verbose = true  # bool: [false|true|0|1]
# Normal console detail. In Stage2, true shows phase transitions and false keeps curve summaries;
# debug_log independently controls debug logging. Stage1 uses the selected backend's normal
# verbosity behavior.
# 控制普通控制台输出的详细程度。Stage2 中 true 显示阶段切换，false 保留曲线摘要；调试日志由
# debug_log 独立控制。Stage1 按各计算后端的普通详细输出规则处理。

# stage1_gpu_backend = "auto"  # string: [auto|cuda|opencl]
# Windows GPU worker. Auto prefers an installed CUDA worker with a visible CUDA device at the
# selected index, then OpenCL. Explicit selection requires that worker beside the executable. Device
# indices belong to the selected backend. Override with --gpu-backend.
# Windows GPU 工作程序。auto 优先同目录的 CUDA 程序及所选编号可见的 CUDA 设备，其次 OpenCL。显式选择
# 要求安装对应程序。设备编号按选中后端解释。--gpu-backend 优先。

target = "gpu"  # string: [cpu|gpu]
# Run Stage1 on CPU or GPU. The stage1_gpu_backend setting selects CUDA or desktop OpenCL. Both
# support Edwards within their own width limits.
# 选择 Stage1 在 CPU 或 GPU 执行。stage1_gpu_backend 选择 CUDA 或桌面 OpenCL。两者均在各自位宽范围内
# 支持 Edwards。

# cpu_implementation = "auto"  # string: [auto|simd|scalar|gwnum|slice list|empty]
# Stage1 arithmetic policy when the target is CPU. A single mode forces its usual behavior; auto or
# an empty value selects by CPU capability and batch size. Above 10240 modulus bits, auto requires
# AVX512-IFMA. A list such as simd[:6144], scalar[:4096], gwnum[4096:], auto[] tries each candidate
# in order on the actual modulus after removing known factors. Overlapping slices are allowed. The
# first available backend whose slice contains the width is selected. Slices include the start and
# exclude the stop. A missing start means 1, a missing stop means unbounded, and [] is equivalent to
# [:]. Whitespace is ignored. Use auto[] for an explicit automatic fallback. simd requires
# AVX512-IFMA. scalar uses GMP and supports widths above 10240 bits only for Edwards. gwnum requires
# Montgomery PARAM0 and a local gwnum.dll beside the Windows x64 worker. GPU workers can inherit
# this TOML policy and leave it inactive.
# 选中 CPU 时使用的 Stage1 算术策略。单值使用对应后端，auto 或空字符串按 CPU 能力与批量自动选择，实
# 际模数超过 10240 位时要求 AVX512-IFMA。支持 simd[:6144], scalar[:4096], gwnum[4096:], auto[] 这样
# 的切片列表。位宽按剥除已知因子后的实际模数计算。允许区间重叠，依次选择首个满足位宽且可用的后端。切
# 片含起点、不含终点，省略起点按 1 位处理，省略终点表示无上限，[] 等同于 [:]，忽略空白。可用 auto[]
# 显式回退到自动选择。simd 要求 AVX512-IFMA，scalar 使用 GMP，超过 10240 位时仅支持 Edwards。gwnum
# 要求 Montgomery PARAM0 和 Windows x64 worker 同目录的本地 gwnum.dll。GPU worker 可继承此 TOML 策
# 略，运行时不启用。

# stage1_gpu_device = 0  # int: <x:Z,0..device_count-1>
# Zero-based GPU device ID for Stage1. Stage2 inherits it unless stage2_device is explicitly set.
# IDs refer to the device list exposed by the executable's actual GPU backend.
# 选择 GPU 设备编号，从 0 开始。用于 Stage1；Stage2 未显式指定 stage2_device 时也继承此编号。编号对
# 应各可执行文件实际使用的 GPU 后端设备列表。

# random_sigma = true  # bool: [false|true|0|1]
# Choose per-curve random sigmas where supported when no seed is supplied. False draws one random
# starting sigma and increments it by one per curve. Montgomery GPU batches already use consecutive
# sigmas. An explicit sigma takes precedence.
# 未指定 σ 时，支持的路径逐曲线随机取值。false 时随机抽取一个起点，之后每条曲线递增 1。GPU
# Montgomery 批次本身就使用连续 σ。显式 σ 优先。

# stage1_submission_file = "results.json.txt"  # string: <path>
# Stage1 submission JSON: seal NF once the whole task completes (B2=B1); publish verified factors
# immediately as individual curves. Private ledgers live under the output directory data/.
# Stage1 提交 JSON：整条任务完成后合并 NF（B2=B1）；验证后的因子立即单曲线输出。私有账本位于输出目录
# 的 data/ 下。

# stage1_results_file = "stage1_results.jsonl"  # string: <path>
# Canonical internal per-curve Stage1 JSONL with CRC32 and execution metadata, separate from
# submission output.
# 统一格式的逐曲线 Stage1 内部 JSONL，包含 CRC32 与执行元数据，与提交文件分开。

[stage2]
# b2_ratio = 0  # u64: [0|1..1000000]
# Stage2 fallback when the CLI, task line and b2 setting supply no nonzero B2. A nonzero ratio uses
# the saved B1 times this value. Applies to queues and GPU direct save runs. Overflow is rejected.
# 命令行、任务行和 b2 配置均未提供非零 B2 时，非零比例使用存档 B1 × ratio 作为上界。适用于队列及 GPU
# 直接读档。乘积超出范围会报错。

# stage2_submission_file = "results.json.txt"  # string: <path>
# Submission-only ECM JSON lines, separate from the internal results JSONL. Uses a reference FFT
# size from Prime95 mult.asm. Personal identifiers and checksums belong only in local ignored files.
# 仅含提交字段的ECM JSON行，与内部结果JSONL分开；FFT长度参考Prime95 mult.asm。个人标识与校验值仅保存
# 在本地忽略文件中。

# stage2_results_file = ""  # string: <path>
# Optional per-curve Stage2 JSONL for CPU and GPU queue tasks. Empty disables it for queue runs.
# Direct save runs use the default filename. Keep the original JSONL until legacy checkpoint
# migration completes.
# CPU 与 GPU 队列任务的可选逐曲线 JSONL。留空时队列不写，直接运行 save 使用默认文件名。旧 checkpoint
# 迁移完成前保留原 JSONL。

# stage2_after_factored = false  # bool: [false|true|0|1]
# After an Edwards Stage1 hit, generate a cofactor save and a local ECM-ELF Stage2 assignment from
# reusable endpoints. Read in the producing worker scope. Default false.
# Edwards Stage1 命中后，从可复用的终点生成余因子存档并交接给本地 ECM-ELF Stage2。按产生存档的
# worker 读取。默认关闭。

# device = "auto"  # string: [auto|cpu|gpu]
# Execution device in the combined Stage2 program. Auto selects by stage2_algorithm; cpu and gpu pin
# the device. CPU supports Edwards saves. Override with --target.
# 统一 Stage2 程序的执行设备。auto 按 stage2_algorithm 选型，cpu 和 gpu 固定设备。CPU 支持 Edwards
# 存档。可用 --target 覆盖。

# stage2_algorithm = "gwnum[4096:], gpu[:16385], cpu[]"  # string: [gwnum|cpu-ntt|cpu-plain|cpu|gpu|cuda|opencl|slice list]
# Algorithm for each task when device is auto in the combined Stage2 program. Rules are tried left
# to right at the saved modulus width. Starts are inclusive, ends exclusive and [] matches any
# width. CPU rules require Edwards; gwnum uses GWNUM/polymult, cpu-ntt and cpu-plain use libecm, cpu
# uses cpu_backend. gpu uses stage2_gpu_backend. GPU input is limited to 16384 bits.
# 统一 Stage2 在 device 为 auto 时按任务选型。按存档实际模数位宽从左到右匹配，含下界、不含上界，[]
# 匹配任意位宽。CPU 规则要求 Edwards；gwnum 使用 GWNUM/polymult，cpu-ntt 和 cpu-plain 使用
# libecm，cpu 读取 cpu_backend。gpu 读取 stage2_gpu_backend，GPU 输入上限为 16384 bit。

# stage2_gpu_device = -1  # int: [-1|0..2^31-1]
# Stage2 CUDA device ID. -1 inherits Stage1's device; 0 or greater selects a CUDA device explicitly.
# Stage2 CUDA 设备编号。-1 继承 Stage1 的 device；0 及以上显式选择 CUDA 设备。

# stage2_gpu_backend = "auto"  # string: [auto|cuda|opencl]
# Windows GPU worker. Auto prefers an installed CUDA worker with a visible CUDA device at the
# selected index, then OpenCL. Explicit selection requires that worker beside the executable. Device
# indices belong to the selected backend. Override with --gpu-backend.
# Windows GPU 工作程序。auto 优先同目录的 CUDA 程序及所选编号可见的 CUDA 设备，其次 OpenCL。显式选择
# 要求安装对应程序。设备编号按选中后端解释。--gpu-backend 优先。

# b2 = 0  # u64: <x:Z,x=0|B1<x<=2^63-1-8192>
# Stage2 upper bound when neither CLI nor task supplies a nonzero B2. 0 defers to other sources.
# Explicit B2 must exceed the save's B1. Larger B2 usually increases coverage, time, and VRAM
# demand. Precedence: nonzero CLI B2, then task B2, then this key.
# 设置未在命令行或任务行给出非零 B2 时使用的 Stage2 上界。0 表示继续从其他来源选择；显式 B2 必须大于
# 存档的 B1。增大 B2 通常增加搜索范围、运行时间及显存需求；命令行非零 B2 优先于任务行，任务行优先于
# 此键。

# auto_b2 = false  # bool: [false|true|0|1]
# Choose B2 when every source supplies zero. 1 optimizes workflow benefit per time including Stage1
# cost; 0 disables. Requires usable Stage2 costs and positive Stage1 s/curve. B1 never gates tune
# reuse; tune_ignore controls other conditions. Memory and carrier divisibility are checked on the
# current input. Estimates retain uncertainty labels; the legacy .cprof interface keeps its original
# qualification checks.
# 所有来源均为零 B2 时自动选择。1 按计入 Stage1 成本的全流程单位时间收益选取；0 关闭。须有可用
# Stage2 成本与正的 Stage1 秒/曲线。B1 不作为 tune 复用门槛；其他条件由 tune_ignore 控制。当前输入仍
# 检查显存及承载整除关系；估算保留不确定性标记，旧 .cprof 接口保持原资格检查。

[gui]
[worker.1]
# autostart = false  # bool: [false|true]
# Start this worker when the GUI opens. The setting applies to GUI startup.
# 设为 true 时，GUI 打开工作流后自动启动此 worker。

