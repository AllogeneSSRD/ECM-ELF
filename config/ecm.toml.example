# GENERATED from config/ecm_options.json / 由 config/ecm_options.json 生成
# ECM_TOML_REFERENCE.en.md lists advanced settings and worker overrides.
# 高级设置和 worker 覆盖见 ECM_TOML_REFERENCE.zh-CN.md。
config_version = 4

[shared]
# worker_count = 1  # int: <x:Z,1..64>
# Workflow worker count for GUI v2 and automatic ECM-ELF handoff within the same queue. Use worker
# numbers 1 through this count. Automatic handoff excludes workers that queue_skip Stage2.
# 供 GUI v2 与同队列 ECM-ELF 自动交接共用的 worker 数量，编号从 1 到该数量。自动交接排除跳过 Stage2
# 的 worker。

# log_file = "ecm.log"  # string: <path>
# Shared run log. Relative paths use the configuration directory. An empty string disables file
# logging.
# 共用运行日志。相对路径基于配置目录。空字符串关闭文件日志。

# finished_file = "worktodo.finished.txt"  # string: <path>
# Shared completed-work file for both stages. Relative paths use the configuration directory.
# 两阶段共用的完成记录。相对路径基于配置目录。

# log_file_max_kb = 10000  # u64: [1000..1000000]
# Rotate the shared run log after its size exceeds this limit. 1 KB is 1000 bytes.
# 共享运行日志超过此上限后归档。1 KB 等于 1000 字节。

# cpu_affinity = ""  # string: [none|auto|<n>,...|<a>-<b>]
# Logical CPUs for the worker process, including host work for GPU backends. Use zero-based indices
# and inclusive ranges, e.g. 0,2,4-7. Empty or auto lets CPU Stage2 select one logical CPU per
# physical core, preferring performance cores. An explicit list allows SMT if the requested thread
# count needs siblings in that list. none leaves CPU Stage2 unbound and disables its tune reuse and
# collection. For other backends, empty, auto and none leave affinity unchanged. A worker may
# override the shared list for both stages.
# worker 进程使用的逻辑 CPU，包括 GPU 后端的主机工作。编号从 0 开始，范围含两端，例如 0,2,4-7。空值
# 或 auto 让 CPU Stage2 每个物理核选一个逻辑 CPU，优先选性能核。显式列表中的不同物理核用完后，可以使
# 用列表内的 SMT 兄弟线程。none 由系统调度，CPU Stage2 停用调优复用和采样。其他后端遇到空值、auto 或
# none 时沿用已有亲和性。可按 worker 同时覆盖两阶段。

# tune_file = "tune.toml"  # string: <path>
# CUDA Stage1, CUDA Stage2 and CPU GWNUM Stage2 share this file. Defaults to tune.toml beside
# ecm.toml. Workers can override the path. An explicit empty value disables automatic persistence.
# CUDA Stage1、CUDA Stage2 和 CPU GWNUM Stage2 共用此文件，默认使用 ecm.toml 同目录的 tune.toml。
# worker 可覆盖路径。显式留空时关闭自动持久化。

worktodo_file = "worktodo.txt"  # string: <path>
# Shared queue. ECM, ECM2 and ECMSTAGE1 select Stage1; ECMSTAGE2 and ECMSTAGE2N select Stage2. One
# process consumes a worker queue at a time.
# 共用队列。ECM、ECM2 和 ECMSTAGE1 交给 Stage1，ECMSTAGE2 和 ECMSTAGE2N 交给 Stage2。同一 worker 同
# 时由一个进程消费队列。

# queue_order = "file_order"  # string: [file_order|stage1_first|stage2_first]
# file_order follows the queue. stage1_first or stage2_first runs the preferred stage until it has
# no remaining tasks, then selects the other stage.
# file_order 按文件顺序选任务。stage1_first 和 stage2_first 优先执行对应阶段，直到该阶段没有剩余任
# 务。

# queue_skip = "none"  # string: [none|stage1|stage2]
# none allows both stages. stage1 or stage2 leaves that stage's tasks in the queue.
# none 允许两阶段执行。stage1 和 stage2 将对应阶段的任务留在队列中。

# user = ""  # string: <local-user-id>
# Optional local result user identity for Stage1 and Stage2. Never put real account values in
# committed templates or fixtures.
# Stage1与Stage2结果的可选本地用户标识；真实账号值不得写入提交的模板或测试样本。

# computer = ""  # string: <local-computer-name>
# Optional local computer name in result output. Keep configured values and generated results
# outside public Git commits.
# 结果输出的可选本地计算机名；实际配置值及生成结果不得进入公共Git提交。

[stage1]
# param = "auto"  # string: [auto|e|m0|m2|m3]
# Stage1 curve construction. With auto, queue tasks default to Edwards and direct input defaults to
# m0 on CPU or m3 on GPU. The optional curve key applies with auto. A typed ECMSTAGE1 save name
# takes precedence.
# Stage1 曲线构造。auto 时，队列任务默认用 Edwards，直接输入在 CPU 上默认用 m0，在 GPU 上默认用 m3。
# curve 可在 auto 时指定曲线。ECMSTAGE1 的存档类型前缀优先。

# handoff_mode = "ecm-elf"  # string: [off|ecm-elf|prime95]
# Send successful Stage1 tasks with usable points and no factor to ECM-ELF Stage2 by default. Append
# the new task at the end of the source worker's queue unless a receiver is configured. Use off to
# keep the save or prime95 to select Prime95.
# Stage1 无因子完成且有可用保存点时，默认在原 worker 队列末尾追加 ECM-ELF Stage2 任务。可配置其他接
# 收方。off 只保留存档，prime95 交给 Prime95。

# handoff_unsupported = "ecm-elf"  # string: [ecm-elf|keep-save]
# Fallback for saves unsupported by the Prime95 protocol.
# Prime95 协议不支持该存档时使用的后备方式。

# handoff_workers = ""  # string: [<n>[slice]|<a>-<b>[slice]|comma list|auto]
# Stage2 receiving workers: IDs and inclusive ID ranges within 1..1000000. Each comma-separated
# entry can have an optional bit slice, e.g. 2[:4096], 3[4096:]. The actual cofactor width is
# matched against inclusive starts and exclusive stops. Omitted brackets, [] and [:] match any
# width. Select the shortest eligible queue, breaking ties by lowest ID. If no slice matches, retain
# the source task. Auto uses worker_count or existing sections for the same queue and considers
# workers that read it and allow Stage2. For external queues, auto prefers existing sections. Empty
# keeps the current worker. Unwritable destinations remain pending for retry.
# Stage2 接收 worker，可填 1..1000000 内的编号或闭区间。逗号分隔的每项可加位宽切片，如 2[:4096],
# 3[4096:]。按实际余因子位宽匹配，包含起点、排除终点。省略方括号、[]、[:] 都匹配任意位宽。选匹配候选
# 中任务最少者，并列取较小编号。无匹配时保留源任务。同队列 auto 使用 worker_count 或已有分区，候选须
# 读取该队列并允许 Stage2。外部队列 auto 优先采用已有分区。留空保留当前 worker。目标不可写时保留待投
# 递记录。

# handoff_worktodo_file = ""  # string: <path>
# Destination queue when auto_stage2=1. Empty inherits this worker's effective shared worktodo_file.
# Accepts an absolute file path or a filename/relative path resolved beside ecm.toml. Save filenames
# in delivered tasks are absolute. Stage2 finished receipts use the receiving worker's
# stage2_finished setting from this TOML. Worker sections can override this setting.
# auto_stage2=1 时的目标队列。留空使用当前 worker 生效的 shared worktodo_file；可填写绝对文件路径，
# 或相对 ecm.toml 所在目录的文件名/路径。投递行中的 save 使用绝对路径。完成去重读取本 TOML 中接收
# worker 的 stage2_finished；worker 分区可覆盖。

stage1_save_dir = "."  # string: <path>
# Output directory for Stage1 curve saves. Stage2 also searches here when stage2_save_dir is unset.
# This is not a Stage2 RAM or VRAM budget.
# 指定 Stage1 曲线存档的输出目录。Stage2 未设置 stage2_save_dir 时也在此目录查找任务引用的 save；此
# 键不是 Stage2 全部临时显存或内存的预算。

# backup_directory_1 = ""  # string: <path>
# First destination for Stage1 save synchronization. Empty disables this destination; backup_mode
# controls the files and synchronization policy. Backup only; this path never authorizes publishing
# a Prime95 task.
# 指定第一个 Stage1 存档同步目录。留空不启用该目标；同步范围和方式由 backup_mode 决定。 仅用于文件备
# 份；此路径不作为 Prime95 任务发布依据。

# backup_directory_2 = ""  # string: <path>
# Second destination for Stage1 save synchronization. Both destinations may be enabled; empty
# disables only this destination. Backup only; this path never authorizes publishing a Prime95 task.
# 指定第二个 Stage1 存档同步目录。可同时向两个目标同步；留空只关闭此目标，不影响第一个目标。 仅用于
# 文件备份；此路径不作为 Prime95 任务发布依据。

# backup_mode = "incremental"  # string: [incremental|full]
# Save synchronization after a Stage1 assignment: incremental copies files updated during that
# assignment; full copies all eligible saves. Startup always performs a full synchronization.
# 控制 Stage1 任务完成后的存档同步。incremental 仅同步本次任务期间更新的文件；full 同步全部符合条件
# 的存档。程序启动时仍执行一次完整同步。

# prime95_save_dir = ""  # string: <path>
# Dedicated save destination for Prime95 handoff; required with prime95_worktodo_file. Backup
# destinations are independent. Existing published save prefixes must remain unchanged; only
# complete appended records may extend them.
# Prime95 交接专用存档目录，启用 prime95_worktodo_file 时必须设置。备份目录独立；已发布存档前缀保持
# 不变，只允许追加完整记录。

# prime95_worktodo_file = ""  # string: <path>
# Prime95 worktodo_file path for supported Montgomery Stage1 handoff. Edwards and GPU PARAM2 ignore
# this path and keep saves local; they do not access Prime95 transfer files. Requires
# prime95_save_dir. The save is validated and published before worktodo_file.add.
# 用于受支持的 Montgomery Stage1 交接的 Prime95 worktodo_file 路径。Edwards 与 GPU PARAM2 自动忽略此
# 路径，存档保留在本地，不访问 Prime95 转移文件。 需同时配置 prime95_save_dir；先验证并发布存档，再
# 写入 worktodo_file.add。

# prime95_workers = ""  # string: [<n>|<n>,...|<a>-<b>|auto]
# Prime95 workers eligible to receive handoffs: one ID, a comma list, or ranges. The shortest
# eligible queue is selected. auto reads NumWorkers from prime.txt in the same directory. Empty
# omits the worker header and uses Prime95's default worker.
# 选择接收交接任务的 Prime95 worker，可指定单个编号、编号列表或区间；程序在候选 worker 中选择队列较
# 短者。auto 从同目录 prime.txt 读取 NumWorkers；留空追加时不写 worker 段头，按 Prime95 的默认
# worker 处理。

# prime95_keep_aid = true  # bool: [false|true|0|1]
# Keep PrimeNet assignment IDs in handoffs: 1 retains IDs not known to be invalid; 0 strips all IDs.
# IDs confirmed invalid by Prime95 logs are always removed to prevent repeated rejection.
# 控制交接任务是否保留 PrimeNet assignment ID。1 保留未被判定失效的 AID，0 一律去掉；已在 Prime95 日
# 志中确认失效的 AID 会去掉，以免任务再次被丢弃。

# prime95_recover_lost = true  # bool: [false|true|0|1]
# Recover handoffs deleted by Prime95 because of invalid assignment IDs. 1 checks handoff records
# and Prime95 logs, then reposts confirmed lost assignments without an ID; 0 disables recovery. Only
# confirmed prior handoffs qualify.
# 控制是否补投被 Prime95 因失效 AID 删除的交接任务。1 根据交接记录和 Prime95 日志检查并去掉 AID 补
# 投，0 关闭自动补投；只对程序能够确认的已交接任务生效。

# cuda_montgomery_chain = "ladder"  # string: [ladder|prac]
# Point multiplication chain for CUDA CGBN Montgomery PARAM0. Other curve families and backends
# ignore this setting. If omitted, the legacy ECM_GPU_STAGE1_ALGO environment override is accepted.
# 为 CUDA CGBN Montgomery PARAM0 选择点乘链。其他曲线族与后端忽略此项。省略时允许使用旧环境变量
# ECM_GPU_STAGE1_ALGO 覆盖。

# cuda_prac_search = 7  # int: [1..50]
# Number of candidate seeds per prime for CUDA PRAC. Keep the same width when resuming a PRAC
# checkpoint.
# CUDA PRAC 对每个素数尝试的种子数量。恢复 PRAC 检查点时应保持相同搜索宽度。

# cuda_slice_depth = 3  # int: [2|3|8]
# CUDA CGBN Stage1 slice submission. Values 2 and 3 keep a rolling queue of up to that many slices.
# Value 8 waits at the end of each group of up to eight.
# CUDA CGBN Stage1 的切片提交方式。2 和 3 分别滚动提交至多两片和三片。8 按最多八片一组等待组尾。

# cuda_low_cpu = false  # bool: [false|true|0|1]
# Set to 1 or true to put the CUDA CGBN Stage1 host thread to sleep while waiting for GPU
# completions, regardless of slice depth. This mode is intended to reduce host CPU use and may
# increase wake-up latency.
# 设为 1 或 true 后，CUDA CGBN Stage1 主机线程在等待 GPU 完成时休眠，对所有切片深度优先生效。此模式
# 用于降低 CPU 占用，唤醒可能稍慢。

# progress_color = "cyan"  # string: [none|red|green|yellow|blue|magenta|cyan|white|grey]
# Color of the Stage1 console progress bar. none disables color. This does not change ordinary file
# logs or arithmetic.
# 选择 Stage1 控制台进度文字颜色。none 关闭着色；此设置不改变普通文件日志内容或计算方式。

# progress_log_seconds = 60  # double: <x:R,finite>
# Interval in seconds between Stage1 progress entries in file logs. Positive values limit frequency;
# 0 suppresses intermediate progress; negative values log every refresh. Completion at 100% is still
# logged. Console refresh frequency is unchanged.
# 控制 Stage1 进度行写入日志文件的间隔，单位为秒。正数按间隔记录，0 不记录中间进度，负数记录每次进度
# 更新；完成时的 100% 行仍会记录。此键不限制控制台刷新频率。

# progress_average_seconds = 0  # double: [0..60]
# Time window for live Stage1 CPU/CUDA s/curve and remaining-time estimates. Zero uses the latest
# valid sample without averaging; positive values average completed work over measured sample time,
# up to 60 seconds. CUDA samples exclude preparation and checkpoint I/O. This does not change
# computation, slicing, final timing or log refresh frequency.
# Stage1 CPU/CUDA 实时 s/curve 与剩余时间估计的平均窗口，单位为秒。0 使用最近一次有效采样，不做平
# 均；正值按采样时长累计已完成工作量，最多 60 秒。CUDA 采样排除准备和 checkpoint 写盘；不改变计算、
# 切片、最终计时或日志刷新频率。

verbose = true  # bool: [false|true|0|1]
# Normal console detail. In Stage2, true shows phase transitions and false keeps curve summaries;
# debug_log independently controls debug logging. Stage1 uses the selected backend's normal
# verbosity behavior.
# 控制普通控制台输出的详细程度。Stage2 中 true 显示阶段切换，false 保留曲线摘要；调试日志由
# debug_log 独立控制。Stage1 按各计算后端的普通详细输出规则处理。

curve = ""  # string: [mont|ed|empty]
# Optional curve override when param is auto. Use mont for Montgomery or ed for Edwards. An omitted
# or empty key uses the mode default. Desktop OpenCL supports Edwards through 1024 bits and
# Montgomery PARAM3.
# param 为 auto 时可用此项指定曲线。mont 为 Montgomery，ed 为 Edwards。省略或留空时按运行模式取默认
# 值。桌面 OpenCL 支持 1024 bit 以内的 Edwards 和 Montgomery PARAM3。

# stage1_gpu_backend = "auto"  # string: [auto|cuda|opencl]
# Windows GPU worker. Auto prefers an installed CUDA worker with a visible CUDA device at the
# selected index, then OpenCL. Explicit selection requires that worker beside the executable. Device
# indices belong to the selected backend. Override with --gpu-backend.
# Windows GPU 工作程序。auto 优先同目录的 CUDA 程序及所选编号可见的 CUDA 设备，其次 OpenCL。显式选择
# 要求安装对应程序。设备编号按选中后端解释。--gpu-backend 优先。

target = "gpu"  # string: [cpu|gpu]
# Run Stage1 on CPU or GPU. The stage1_gpu_backend setting selects CUDA or desktop OpenCL. Both
# support Edwards within their own width limits.
# 选择 Stage1 在 CPU 或 GPU 执行。stage1_gpu_backend 选择 CUDA 或桌面 OpenCL。两者均在各自位宽范围内
# 支持 Edwards。

# cpu_implementation = "auto"  # string: [auto|simd|scalar|gwnum|slice list|empty]
# Stage1 arithmetic policy when the target is CPU. A single mode forces its usual behavior; auto or
# an empty value selects by CPU capability and batch size. Above 10240 modulus bits, auto requires
# AVX512-IFMA. A list such as simd[:6144], scalar[:4096], gwnum[4096:], auto[] tries each candidate
# in order on the actual modulus after removing known factors. Overlapping slices are allowed. The
# first available backend whose slice contains the width is selected. Slices include the start and
# exclude the stop. A missing start means 1, a missing stop means unbounded, and [] is equivalent to
# [:]. Whitespace is ignored. Use auto[] for an explicit automatic fallback. simd requires
# AVX512-IFMA. scalar uses GMP and supports widths above 10240 bits only for Edwards. gwnum requires
# Montgomery PARAM0 and a local gwnum.dll beside the Windows x64 worker. GPU workers can inherit
# this TOML policy and leave it inactive.
# 选中 CPU 时使用的 Stage1 算术策略。单值使用对应后端，auto 或空字符串按 CPU 能力与批量自动选择，实
# 际模数超过 10240 位时要求 AVX512-IFMA。支持 simd[:6144], scalar[:4096], gwnum[4096:], auto[] 这样
# 的切片列表。位宽按剥除已知因子后的实际模数计算。允许区间重叠，依次选择首个满足位宽且可用的后端。切
# 片含起点、不含终点，省略起点按 1 位处理，省略终点表示无上限，[] 等同于 [:]，忽略空白。可用 auto[]
# 显式回退到自动选择。simd 要求 AVX512-IFMA，scalar 使用 GMP，超过 10240 位时仅支持 Edwards。gwnum
# 要求 Montgomery PARAM0 和 Windows x64 worker 同目录的本地 gwnum.dll。GPU worker 可继承此 TOML 策
# 略，运行时不启用。

# cpu_simd_reduction = "auto"  # string: [auto|montgomery|mersenne-fold]
# CPU SIMD modular cpu_simd_reduction. auto selects for the input; mersenne-fold requires N=2^p-1;
# montgomery uses general cpu_simd_reduction. An explicit cpu_simd_reduction requires impl=simd, so
# it cannot be silently ignored when auto chooses scalar.
# CPU SIMD 模约减：auto 按输入数选择；mersenne-fold 要求 N=2^p-1；montgomery 使用通用约减。显式归约
# 要求 impl=simd，避免 auto 选中标量时悄悄忽略设置。

# cpu_montgomery_chain = "ladder"  # string: [ladder|prac]
# Montgomery CPU point multiplication. prac requires target=cpu, curve=mont, impl=simd and B1 in
# 2..4294967295. It shares the scalar convention and final save format with ladder, with its own
# in-flight checkpoint state.
# Montgomery CPU 点乘。prac 要求 target=cpu、curve=mont、impl=simd 和 B1 在 2..4294967295 之间。它与
# ladder 使用相同的标量约定及最终 save 格式，各自使用不同的运行中检查点状态。

# cpu_prac_search = 7  # int: [1..50]
# Number of candidate seeds per prime for CPU IFMA PRAC. Keep the same width when resuming a PRAC
# checkpoint.
# CPU IFMA PRAC 对每个素数尝试的种子数量。恢复 PRAC 检查点时应保持相同搜索宽度。

# stage1_cpu_threads = 0  # u32: <x:Z,0..2^32-1>
# CPU Stage1 arithmetic and preparation threads. 0 uses the backend's automatic selection. Override
# with --cpu-threads.
# CPU Stage1 算术与准备线程数。0 由后端自动选择。命令行 --cpu-threads 可覆盖。

# gpu_init_threads = 0  # u32: <x:Z,0..2^32-1>
# Host curve-construction threads for Edwards CUDA CGBN, CUDA NTT and CUDA/OpenCL
# one-thread-per-curve Stage1. 0 uses the backend's default. Work is bounded by the available CPUs,
# curves and memory where applicable. Override with --gpu-init-threads.
# Edwards CUDA CGBN、CUDA NTT 和 CUDA/OpenCL 一线程一曲线 Stage1 的主机构造线程数。0 由后端自动选
# 择。实际线程受可用 CPU、曲线数和适用的内存预算限制。命令行 --gpu-init-threads 可覆盖。

# save_name_pattern = "{curve}_{target}_{b1}.save"  # string: <pattern>
# Automatic Stage1 save filename pattern for CPU and GPU. {curve}=e|m0|m2|m3; {target}=m<exponent>
# for Mersenne assignments, otherwise bit<actual_bits>; {n}=original assignment exponent when
# available, otherwise actual bits; {b1}=compact B1. Missing curve prefixes are added. In ECMSTAGE1
# queues, typed save prefixes override TOML curve/param and the final filename field supplies B1;
# untyped names use the TOML construction. Finished/handoff lines name the actual prefixed save.
# Explicit CLI save paths are preserved. Empty restores the default.
# 统一设置 CPU/GPU Stage1 自动 save 文件名。{curve}=e|m0|m2|m3；{target}=梅森任务的 m<指数>，否则为
# bit<实际位数>；{n}=原任务指数，无任务元数据时为实际位数；{b1}=紧凑 B1。缺少曲线前缀时自动补充。
# ECMSTAGE1 队列中，类型前缀覆盖 TOML 曲线/param，末尾文件名字段给出 B1；无类型前缀时沿用 TOML。完成
# /交接行使用实际带前缀的 save；CLI 显式 save 路径保持原样。留空恢复默认。

# exponent_cache_dir = ""  # string: [off|none|0|-|<dir>]
# Directory for Stage1 scalar and PRAC caches. Empty uses cache/ at the checkout root, or cache/
# next to the executable for standalone installs. off, none, 0, or - disables caching. Explicit
# relative paths use the current working directory. Small B1 values may queue_skip writing the
# scalar cache.
# 指定 Stage1 指数及 PRAC 计划缓存目录。留空使用仓库根目录的 cache/，独立部署使用可执行文件同级的
# cache/。off、none、0 或 - 关闭缓存。显式相对路径以进程当前工作目录为基准。较小的 B1 可能不写指数缓
# 存。

# edwards_naf_window_bits = 0  # int: [0|2..12]; CPU: [0|3..12]
# Requested Edwards NAF window. 0 starts at 12 for CPU and 6 for CUDA CGBN or OpenCL. With CUDA NTT,
# 0 selects the fastest compatible measured NAF window (x-only fallback). Values 2–12 fix the 2XY
# NAF window. CPU, CGBN and OpenCL can lower the window for a fresh task to fit the memory budget.
# Edwards NAF 请求窗口。0 在 CPU 从 12 开始，在 CUDA CGBN 和 OpenCL 从 6 开始。CUDA NTT 中 0 按兼容
# 实测吞吐选择窗口，无记录可用时回退 x-only，2～12 固定 2XY NAF 窗口。CPU、CGBN 和 OpenCL 可根据内存
# 预算为新任务自动降窗。

# edwards_doubling = 1  # int: [0|1]
# Doubling formula for new CUDA CGBN and OpenCL Edwards NAF batches. 0 selects HWCD, 1 selects 2XY
# (default). Resume uses the saved formula. CUDA CGBN also accepts ECM_EDWARDS_DBL_ALGO when this
# key is omitted.
# 新 CUDA CGBN 与 OpenCL Edwards NAF 批次的倍点公式。0 选择 HWCD，1 选择 2XY（默认）。续跑沿用检查点
# 中的公式。省略此键时，CUDA CGBN 还支持 ECM_EDWARDS_DBL_ALGO。

# naf_memory_mb = 0  # int: [0|1..1048576]
# Edwards Stage1 memory cap in MB (1 MB = 1,000,000 bytes). Limits the CPU NAF working set, CUDA
# CGBN or OpenCL device buffers, or CUDA NTT dictionaries and their device product tree. 0 uses the
# backend budget. OpenCL uses half the reported global memory and also checks the maximum allocation
# size.
# Edwards Stage1 内存上限，1 MB = 1,000,000 字节。约束 CPU NAF 工作集、CUDA CGBN 或 OpenCL 设备缓
# 冲、CUDA NTT 字典及设备乘积树。0 使用后端预算。OpenCL 以报告的全局内存一半为预算，并检查单个缓冲的
# 最大容量。

# ntt_naf_gpu_min_bits = "auto"  # int|string: [auto|0..5242881]
# Minimum Mersenne exponent for GPU Edwards NAF dictionary construction in CUDA NTT production and
# tuning. Auto (or 0) uses built-in thresholds. A positive value selects the GPU at and above that
# exponent, subject to memory limits. 5242881 selects GMP for all supported exponents. Tune prepares
# one curve.
# CUDA NTT 生产和调优使用 GPU 构造 Edwards NAF 字典的最小梅森指数。auto 或 0 使用内置门槛，正整数表
# 示指数达到该值时优先 GPU，仍受内存预算限制。5242881 表示所有支持的指数都用 GMP。调优按一条曲线准备
# 字典。

# montgomery_lcm_multiplier = "1"  # string: [1|12]
# Montgomery Stage1 scalar is montgomery_lcm_multiplier(1..B1) multiplied by 1 or 12. Edwards uses
# its fixed 48*montgomery_lcm_multiplier scalar and rejects 12. This choice changes the output point
# and must match the Stage2 save convention.
# Montgomery Stage1 标量是 montgomery_lcm_multiplier(1..B1) 乘 1 或 12。Edwards 固定使用
# 48·montgomery_lcm_multiplier，不接受 12。此选择改变输出点，须与 Stage2 存档约定一致。

# sigma = 0  # u64: <x:Z,0..2^64-1>
# Initial curve sigma. 0 chooses a random value; consecutive curves use sigma+i without 64-bit
# wraparound. CUDA PARAM0 accepts the full 64-bit range, while PARAM2/3 batches must stay below
# 2^32. CPU runs warn if a sigma exceeds Prime95's signed reader range; this is not a Stage1 limit.
# A nonzero ECM/ECM2 assignment sigma overrides this setting.
# 曲线起始 sigma；0 表示随机生成，连续曲线使用 sigma+i 且不得在 64 位处回绕。CUDA PARAM0 接受完整 64
# 位范围，PARAM2/3 批次须位于 2^32 以下。CPU 路径的 sigma 超出 Prime95 有符号读取范围时会警告，这不
# 是 Stage1 的限制。ECM/ECM2 任务行的非零 sigma 覆盖此键。

# checkpoint_backups = 3  # int: <x:Z,0..16>
# Maximum number of rotated Stage1 checkpoint backups. The primary checkpoint is additional; 0 keeps
# only the primary. Corrupt or unreadable generations are skipped on resume. A completed Stage1 task
# removes its primary checkpoint and all backups.
# Stage1 检查点轮换备份的最大份数；主存档另计，0 表示只保留主存档。恢复时跳过损坏或无法读取的代次；
# Stage1 完成后清理主存档及所有备份。

# checkpoint_interval_seconds = 600  # double: <x:R,finite,x>=0>
# Stage1 checkpoint interval in seconds. 0 disables periodic checkpoints; negative values act as 0.
# Normal stop or Ctrl+C can still request a checkpoint. Actual writes wait for the backend's safe
# checkpoint boundary.
# 设置 Stage1 定期写检查点的间隔，单位为秒。0 关闭定期检查点，负数按 0 处理；仍可通过正常停止或
# Ctrl+C 请求保存。实际写盘时机受当前计算后端的安全检查点限制。

# stage1_gpu_device = 0  # int: <x:Z,0..device_count-1>
# Zero-based GPU device ID for Stage1. Stage2 inherits it unless stage2_device is explicitly set.
# IDs refer to the device list exposed by the executable's actual GPU backend.
# 选择 GPU 设备编号，从 0 开始。用于 Stage1；Stage2 未显式指定 stage2_device 时也继承此编号。编号对
# 应各可执行文件实际使用的 GPU 后端设备列表。

# gpu_algorithm = "ntt[16384:], cgbn[]"  # int|string: [1|2|3|cgbn|ntt|thread|slice list]
# Stage1 GPU algorithm, case-insensitive. Single values 1/cgbn, 2/ntt and 3/thread explicitly select
# an algorithm. A slice list tries compatible algorithms from left to right at the actual modulus
# width, with inclusive starts and exclusive ends. Empty brackets match any width. CUDA NTT requires
# a full Mersenne modulus and Edwards or Montgomery PARAM0. CUDA thread requires Edwards up to 1024
# bits. The cgbn rule uses the linked OpenCL algorithm on an OpenCL worker.
# Stage1 GPU 算法，不区分大小写。单值 1/cgbn、2/ntt 和 3/thread 显式指定算法。切片列表按实际模数位宽
# 从左到右尝试可用的算法，含下界、不含上界，空括号匹配任意位宽。CUDA NTT 要求完整梅森模数，支持
# Edwards 和 Montgomery PARAM0。CUDA thread 支持最高 1024 bit 的 Edwards。OpenCL worker 的 cgbn 规则
# 使用其原有 OpenCL 算法。

# random_sigma = true  # bool: [false|true|0|1]
# Choose per-curve random sigmas where supported when no seed is supplied. False draws one random
# starting sigma and increments it by one per curve. Montgomery GPU batches already use consecutive
# sigmas. An explicit sigma takes precedence.
# 未指定 σ 时，支持的路径逐曲线随机取值。false 时随机抽取一个起点，之后每条曲线递增 1。GPU
# Montgomery 批次本身就使用连续 σ。显式 σ 优先。

# thread_block_size = 128  # int: [32|64|128|256]
# CUDA block size for the Edwards thread algorithm only. Use 32, 64, 128 or 256. CLI --wg overrides
# it; --wg 0 selects 128.
# 仅用于 CUDA Edwards thread 的线程块大小，可选 32、64、128 或 256。CLI --wg 可覆盖，--wg 0 选择 128
# 。

# ntt_convolution = "auto"  # string: [auto|linear|weighted]
# Auto selects the measured backend or calibrates on a cache miss. Explicit modes select exact
# linear convolution or weighted cyclic convolution (IBDWT). Both use Goldilocks and the same Stage1
# task and checkpoint format.
# auto 按测量选型，缺失时短调优；也可显式选择精确线性卷积或加权循环卷积（IBDWT）。两者都使用
# Goldilocks，共用 Stage1 任务及检查点格式。

# ntt_allow_known_factors = 1  # int: [0|1]
# 1 allows Mersenne assignments with known factors to use NTT arithmetic modulo the full 2^p-1.
# Construction, factor checks and published saves use the remaining cofactor. 0 excludes this
# carrier path. Algorithm slice rules still match the cofactor bit width.
# 1 允许带已知因子的梅森任务使用完整 2^p-1 进行 NTT 运算。曲线构造、因子检查和发布存档使用剩余余因
# 子。0 禁用此承载路径。算法切片仍按余因子的位宽匹配。

# ntt_pad_batch = 0  # int: [0|1]
# 0 runs exactly the requested number of Stage1 NTT curves. 1 rounds the final batch up to the
# selected size when resources permit. Each extra curve gets a new sigma and is included in the
# results and any eligible Stage2 handoff.
# 0 按任务请求的曲线数运行 Stage1 NTT。1 在资源允许时用真实曲线把尾批补齐到优选批量。新增曲线使用独
# 立 sigma，计入结果和符合条件的 Stage2 交接。

# ntt_tight_weighted_bound = true  # bool: [false|true|0|1]
# Use the tighter unsigned coefficient bound for native Edwards NAF in CUDA Stage1. Automatic
# selection benchmarks eligible shorter weighted plans alongside the other safe shapes. False uses
# the conservative bound.
# CUDA Stage1 的原生 Edwards NAF 使用更紧的无符号系数界。自动选型将通过该界的短加权计划与其他合法计
# 划一同实测。false 使用保守界。

# ntt_max_batch = 512  # int: [1,512]
# Maximum curves per new CUDA Stage1 NTT batch in tuning and production. Available memory can lower
# the limit for each transform and NAF window.
# CUDA Stage1 NTT 调优和生产每个新批次的曲线数上限。各变换长度和 NAF 窗口的实际容量还受内存预算限
# 制。

# ntt_batch_target_percent = 95  # int: [1,100]
# Throughput threshold as a percentage of the eligible CUDA Stage1 NTT peak. Prefer the requested
# curve count when it meets the threshold. When splitting, select the smallest measured batch
# meeting the threshold relative to the eligible sub-batch peak.
# CUDA Stage1 NTT 选批的吞吐门槛，以可行峰值的百分比表示。请求批量达标时优先整批执行。需要拆批时，选
# 择达到可行子批峰值该比例的最小实测批量。

# ntt_memory_mib = 0  # int: [0,1048576]
# Total Stage1 NTT VRAM budget in MiB. Zero uses 80% of free VRAM after CUDA initialization. An
# explicit cap is also bounded by available VRAM.
# Stage1 NTT 总显存预算（MiB）。0 使用 CUDA 初始化后空闲显存的 80%；显式预算也受空闲显存限制。

# ntt_length = 0  # int: 0, 2^k in [2,524288], or 5*2^k in [2560,163840] (weighted)
# Transform length. Zero derives safe lengths, including shorter supported radix-5 shapes for
# weighted convolution.
# 变换长度。0 推导安全长度，加权卷积包含支持且更短的 radix-5 形状。

# ntt_bits_per_word = 0  # int: 0 or [16,31]
# Bits per digit. Zero selects the widest exact linear packing or the shortest safe weighted
# transform. In weighted mode, an explicit value is an upper bound on the largest digit.
# 每个数字的位数。0 选择最宽精确线性表示或最短安全加权变换。加权模式下，显式值限制最大 digit 位宽。

# ntt_profile = 0  # int: [0|1|2]
# Per-length transform profile: 0 automatic, 1 full tile (up to 12 bits), 2 split tile (up to 10
# bits). Explicit tile and outer overrides take precedence.
# 按长度选择的变换配置：0 自动，1 大 tile（至多 12 层），2 分块 tile（至多 10 层）。显式 tile 和外层
# 设置优先。

# ntt_tile = 0  # int: [0,12]
# Fused tile width in radix-2 layers. Zero uses the profile.
# 融合 tile 的 radix-2 层数。0 使用所选配置。

# ntt_outer_radix_limit = 0  # int: [0,4]
# Maximum fused radix-2 layers per outer pass. Zero uses the profile.
# 每个外部 pass 最多融合的 radix-2 层数。0 使用所选配置。

# ntt_window_bits = -1  # int: [-1,64]
# Ladder bits per CUDA Graph replay. -1 uses the profile; 0 uses direct launches.
# 每次 CUDA Graph 重放处理的阶梯位数。-1 使用所选配置，0 使用直接启动。

# ntt_warp_tail = "auto"  # bool|string: [auto|false|true|0|1]
# Enable warp shuffles for the local tail of the tile transform. Auto uses the selected profile.
# 用 warp shuffle 处理 tile 变换的局部尾部。auto 使用所选配置。

# opencl_threads_per_integer = 8  # u32: [1|2|4|8|16|32]
# OpenCL threads per integer, subject to limb-layout constraints. CUDA selects TPI by operand width
# and ignores this key. This is not the CUDA block size.
# 设置 OpenCL 每个大整数使用的线程数，需满足有效 TPI 与整数 limb 数的布局约束。CUDA 后端自行按位宽选
# 择 TPI，不使用此键；不要用它调整 CUDA 的线程块大小。

# opencl_workgroup_size = 0  # int: <x:Z,x>=0>
# OpenCL work-group size. 0 lets the backend select automatically; explicit values must satisfy
# device and kernel limits. CUDA ignores this setting.
# 设置 OpenCL 工作组大小，0 由后端自动选择。显式值必须满足当前设备和内核的限制；CUDA 后端不使用此设
# 置。

# opencl_kernel_mul = ""  # string: [auto|<id>|<alias>]
# OpenCL modular multiplication. PARAM3 accepts registered IDs and aliases. Edwards defaults to cios
# and accepts fips or NVIDIA-only fips_ptx through 512-bit moduli. CUDA ignores this key.
# 选择 OpenCL 模乘。PARAM3 接受注册的内核 ID 和别名。Edwards 默认 cios，最高 512 bit 可选 fips 或
# NVIDIA 专用的 fips_ptx。CUDA 忽略此键。

# opencl_kernel_sqr = ""  # string: [auto|<id>|<alias>]
# OpenCL modular squaring. PARAM3 accepts registered IDs and aliases. Edwards auto reuses the
# selected multiplier. Explicit cios selects CIOS, while fips and NVIDIA-only fips_ptx select
# symmetric FIPS through 512 bits. On one Edwards task, select the same FIPS implementation for both
# operators that use FIPS. CUDA ignores this key.
# 选择 OpenCL 模平方。PARAM3 接受注册的内核 ID 和别名。Edwards 的 auto 复用所选模乘，cios 强制使用
# CIOS，fips 和 NVIDIA 专用的 fips_ptx 在 512 bit 以内使用对称 FIPS。一个 Edwards 任务使用同一种
# FIPS 实现。CUDA 忽略此键。

# opencl_kernel_add = ""  # string: [auto|<id>|<alias>]
# OpenCL modular-addition kernel ID or alias. Empty or auto lets the backend choose; automatic
# selection is normally suitable. CUDA ignores this key.
# 指定 OpenCL 模加内核的标识或别名。空值或 auto 由后端选择；通常保持自动，CUDA 后端忽略此键。

# opencl_kernel_sub = ""  # string: [auto|<id>|<alias>]
# OpenCL modular-subtraction kernel ID or alias. Empty or auto lets the backend choose; automatic
# selection is normally suitable. CUDA ignores this key.
# 指定 OpenCL 模减内核的标识或别名。空值或 auto 由后端选择；通常保持自动，CUDA 后端忽略此键。

# opencl_kernel_special_mult = ""  # string: [auto|<id>|<alias>]
# OpenCL special-multiplication kernel ID or alias. Empty or auto lets the backend choose; automatic
# selection is normally suitable. CUDA ignores this key.
# 指定 OpenCL 特殊乘法内核的标识或别名。空值或 auto 由后端选择；通常保持自动，CUDA 后端忽略此键。

# stage1_submission_file = "results.json.txt"  # string: <path>
# Stage1 submission JSON: seal NF once the whole task completes (B2=B1); publish verified factors
# immediately as individual curves. Private ledgers live under the output directory data/.
# Stage1 提交 JSON：整条任务完成后合并 NF（B2=B1）；验证后的因子立即单曲线输出。私有账本位于输出目录
# 的 data/ 下。

# stage1_results_file = "stage1_results.jsonl"  # string: <path>
# Canonical internal per-curve Stage1 JSONL with CRC32 and execution metadata, separate from
# submission output.
# 统一格式的逐曲线 Stage1 内部 JSONL，包含 CRC32 与执行元数据，与提交文件分开。

[stage2]
# b2_ratio = 0  # u64: [0|1..1000000]
# Stage2 fallback when the CLI, task line and b2 setting supply no nonzero B2. A nonzero ratio uses
# the saved B1 times this value. Applies to queues and GPU direct save runs. Overflow is rejected.
# 命令行、任务行和 b2 配置均未提供非零 B2 时，非零比例使用存档 B1 × ratio 作为上界。适用于队列及 GPU
# 直接读档。乘积超出范围会报错。

# stage2_submission_file = "results.json.txt"  # string: <path>
# Submission-only ECM JSON lines, separate from the internal results JSONL. Uses a reference FFT
# size from Prime95 mult.asm. Personal identifiers and checksums belong only in local ignored files.
# 仅含提交字段的ECM JSON行，与内部结果JSONL分开；FFT长度参考Prime95 mult.asm。个人标识与校验值仅保存
# 在本地忽略文件中。

# stage2_results_file = ""  # string: <path>
# Optional per-curve Stage2 JSONL for CPU and GPU queue tasks. Empty disables it for queue runs.
# Direct save runs use the default filename. Keep the original JSONL until legacy checkpoint
# migration completes.
# CPU 与 GPU 队列任务的可选逐曲线 JSONL。留空时队列不写，直接运行 save 使用默认文件名。旧 checkpoint
# 迁移完成前保留原 JSONL。

# debug_log_file = ""  # string: <path>
# Separate Stage2 debug log, written only when debug_log is enabled. Empty restores the default
# filename. Default names gain a worker suffix; explicit paths are used unchanged.
# 指定 Stage2 独立调试日志文件，仅在 debug_log 开启时写入。留空恢复默认文件名；默认名称按 worker 加
# 后缀，显式指定时按原路径使用。

# checkpoint_legacy_file = ""  # string: <path>
# Legacy single-file progress import path. Empty checks the old queue-path plus worker-suffix
# .progress file. A matching task's completed count and pending receipt are imported into its own
# .ecm_ckpt_stage2_<bits>_<B1>.dat file. An unrelated legacy task is retained and does not stop this
# task. New progress files use checkpoint_dir; no arithmetic state is checkpointed.
# 旧单文件进度的导入路径。空值检查旧的队列路径加 worker 后缀 .progress 文件；匹配任务的完成数和待确
# 认回执迁入独立 .ecm_ckpt_stage2_<bits>_<B1>.dat 文件。不相关的旧任务保留，当前任务继续。新进度文件
# 使用 checkpoint_dir，不保存曲线内部算术状态。

# checkpoint_dir = ""  # string: <dir>
# Directory for per-task .ecm_ckpt_stage2_<bits>_<B1>.dat progress files. Empty uses the legacy
# progress file's directory if explicitly set, otherwise the queue directory. Task IDs bind AID, N,
# full save contents and queue_skip. On restart the current effective B2/Auto B2 and requested curve
# count override the checkpoint policy; completed curves retain their actual bounds. A target below
# the completed count warns and seals all completed work. New checkpoints contain completed curve
# state and pending submission data. They are removed after publication and queue advancement.
# 每任务 .ecm_ckpt_stage2_<bits>_<B1>.dat 进度文件的目录。空值使用显式旧进度路径的父目录，否则使用队
# 列目录。任务 ID 绑定 AID、N、完整 save 内容和 queue_skip。重启采用当前有效 B2/Auto B2 及请求曲线
# 数，已完成曲线保留实际界限；请求数小于已完成数时警告并封存全部已完成工作。新 checkpoint 保存已完成
# 曲线状态和待发布结果；结果发布并推进队列后清除。

# stage2_save_dir = ""  # string: <dir>
# Directory searched for saves referenced by Stage2 assignments. Empty inherits tmp_dir; absolute
# save paths in assignments are used directly. Source saves are read and validated without
# modification.
# 指定 Stage2 查找任务所引用 save 的目录。留空继承共享 tmp_dir；任务给出绝对 save 路径时直接使用该路
# 径。程序读取并验证源 save，不修改其内容。

# debug_log = false  # bool: [false|true|0|1]
# Write Stage2 debug details to a separate log: true enables and false disables. verbose=true does
# not enable debug logging; enabling this option does not send all debug details to the console.
# 控制是否将 Stage2 调试细节写入独立日志。true 开启，false 关闭；verbose=true 不会自动开启调试日志，
# 开启本选项也不把全部调试输出刷到控制台。

# stage2_after_factored = false  # bool: [false|true|0|1]
# After an Edwards Stage1 hit, generate a cofactor save and a local ECM-ELF Stage2 assignment from
# reusable endpoints. Read in the producing worker scope. Default false.
# Edwards Stage1 命中后，从可复用的终点生成余因子存档并交接给本地 ECM-ELF Stage2。按产生存档的
# worker 读取。默认关闭。

# device = "auto"  # string: [auto|cpu|gpu]
# Execution device in the combined Stage2 program. Auto selects by stage2_algorithm; cpu and gpu pin
# the device. CPU supports Edwards saves. Override with --target.
# 统一 Stage2 程序的执行设备。auto 按 stage2_algorithm 选型，cpu 和 gpu 固定设备。CPU 支持 Edwards
# 存档。可用 --target 覆盖。

# stage2_algorithm = "gwnum[4096:], gpu[:16385], cpu[]"  # string: [gwnum|cpu-ntt|cpu-plain|cpu|gpu|cuda|opencl|slice list]
# Algorithm for each task when device is auto in the combined Stage2 program. Rules are tried left
# to right at the saved modulus width. Starts are inclusive, ends exclusive and [] matches any
# width. CPU rules require Edwards; gwnum uses GWNUM/polymult, cpu-ntt and cpu-plain use libecm, cpu
# uses cpu_backend. gpu uses stage2_gpu_backend. GPU input is limited to 16384 bits.
# 统一 Stage2 在 device 为 auto 时按任务选型。按存档实际模数位宽从左到右匹配，含下界、不含上界，[]
# 匹配任意位宽。CPU 规则要求 Edwards；gwnum 使用 GWNUM/polymult，cpu-ntt 和 cpu-plain 使用
# libecm，cpu 读取 cpu_backend。gpu 读取 stage2_gpu_backend，GPU 输入上限为 16384 bit。

# stage2_gpu_device = -1  # int: [-1|0..2^31-1]
# Stage2 CUDA device ID. -1 inherits Stage1's device; 0 or greater selects a CUDA device explicitly.
# Stage2 CUDA 设备编号。-1 继承 Stage1 的 device；0 及以上显式选择 CUDA 设备。

# log_level = "phases"  # int|string: [quiet|curve|phases|batches|debug|0..4]
# Legacy console level: quiet, curve, phases, batches, and debug map to 0..4. Unset follows verbose.
# In production, debug enables the separate debug log while normal console detail remains capped at
# batches. Usually use verbose and debug_log.
# 兼容旧配置的控制台日志等级：quiet、curve、phases、batches、debug 分别对应 0..4。未配置时由 verbose
# 决定；debug 在生产程序中开启独立调试日志，普通控制台最高保持 batches。一般只需使用 verbose 和
# debug_log。

# ntt_length_counts = false  # bool: [false|true|0|1]
# Print a per-curve NTT length count table at the end of production Stage2: 1 enables; 0 disables
# collection and output. Counts mathematical transforms (two forwards and one inverse per
# convolution), including polynomial initialization and main work, excluding Stage1 and independent
# arithmetic selftests. Shared by Edwards and Montgomery; no GPU counters or extra synchronization.
# CLI --ntt-counts overrides the selected worker TOML.
# 生产 Stage2 每条曲线结束时输出 NTT 长度计数表：1 开启，0 关闭采集与输出。统计数学变换次数，每次卷
# 积含两个正向与一个逆向；包含多项式初始化及主计算，不含 Stage1 或底层独立算术自检。
# Edwards/Montgomery 通用，不增加设备计数或额外同步。CLI --ntt-counts 覆盖选定 worker 的 TOML。

# stage2_gpu_backend = "auto"  # string: [auto|cuda|opencl]
# Windows GPU worker. Auto prefers an installed CUDA worker with a visible CUDA device at the
# selected index, then OpenCL. Explicit selection requires that worker beside the executable. Device
# indices belong to the selected backend. Override with --gpu-backend.
# Windows GPU 工作程序。auto 优先同目录的 CUDA 程序及所选编号可见的 CUDA 设备，其次 OpenCL。显式选择
# 要求安装对应程序。设备编号按选中后端解释。--gpu-backend 优先。

# cpu_backend = "auto"  # string: [auto|gwpoly|ntt|plain]
# CPU arithmetic for Edwards continuation. Auto uses GWNUM/polymult when available, then libecm.
# Override with --backend.
# Edwards CPU 续算的算术后端。auto 优先使用 GWNUM/polymult，其次是 libecm。命令行 --backend 可覆盖。

# stage2_cpu_threads = 1  # u64: [1,1024]
# Requested thread count per CPU Stage2 worker, capped by the selected affinity pool. Override with
# --threads.
# 每个 CPU Stage2 worker 请求的线程数，以所选亲和性范围可用的线程数为上限。命令行 --threads 可覆盖。

# cpu_memory_mib = 512  # u64: [1,1048576]
# CPU Stage2 arithmetic memory budget in MiB. Override with --memory-mib.
# CPU Stage2 算术内存预算，单位为 MiB。命令行 --memory-mib 可覆盖。

# cpu_tune_candidates = 5  # u64: [1,16]
# Maximum GWNUM Stage2 plans considered for one workload, including the baseline and alternative D
# and F-tree layouts. 1 keeps only the baseline. ABI 4 can return up to three D choices. Override
# with --cpu-tune-candidates.
# 一个 GWNUM Stage2 条件最多比较的计划数，包含默认计划、备选 D 和 F 树布局。1 只保留默认计划。ABI 4
# 最多提供三个 D。命令行 --cpu-tune-candidates 可覆盖。

# cpu_tune_dense_d = true  # bool: [false|true|0|1]
# Enumerate intermediate D values for GWNUM Stage2 tuning on ABI 5. Disable to search the original
# wheels. Override with --cpu-tune-dense-d 0|1.
# 用 ABI 5 调优 GWNUM Stage2 时枚举更细的 D 档位。关闭后使用原有轮候选。命令行 --cpu-tune-dense-d
# 0|1 可覆盖。

# opencl_point_plan = "auto"  # string: [auto|device|chain|cpu]
# OpenCL point generation. Auto starts with the qualified plan and can learn from complete curves.
# Device selects the device ladder plan (including its qualified short batches); chain requests
# consecutive giant seeds; cpu uses GMP points with OpenCL trees. Manual settings bypass runtime
# exploration.
# OpenCL 点生成。auto 从已验证的默认计划起步，可用完整曲线继续调优。device 使用设备点计划（含已验证
# 短批次）；chain 选择连续巨步种子；cpu 使用 GMP 点及 OpenCL 树。手动计划跳过运行时探索。

# opencl_point_chunk = 0  # u64: [0..4096]
# Maximum points per OpenCL command. Zero uses automatic sizing. A positive value locks the chunk
# and disables runtime plan trials.
# 每条 OpenCL 命令的点数。0 自动；正值锁定分块并关闭运行时计划试探。

# opencl_point_group = 0  # u64: [0..4096]
# Local OpenCL point work-group size. Zero uses the backend default. Positive sizes must fit both
# device and kernel limits.
# OpenCL 点工作组大小。0 使用后端默认；正值必须符合设备与内核上限。

# opencl_point_window = 0  # u64: [0..65536]
# Giant coordinate staging window in points. Zero uses the backend plan; positive requests are
# clipped by the budget and G batch boundaries.
# 巨步坐标暂存窗口点数。0 由后端选型；正值按预算和 G 批次边界调整。

# opencl_short_point_batch = true  # bool: [false|true|0|1]
# Allow qualified short device batches. False disables batched baby ladders and paired giants from
# the short-batch policy.
# 允许已验证的短设备批次。关闭后不使用该策略合并 baby 提交及配对 giant。

# opencl_tune_file = "stage2_opencl_tune.toml"  # string: <path>
# Native OpenCL point timing profile. Relative to ecm.toml, with per-worker overrides. Empty
# disables profile learning. Uses tune_runtime_enabled, tune_min_repeats and
# tune_runtime_sample_limit.
# 原生 OpenCL 点计划计时文件。相对 ecm.toml，可按 worker 覆盖；空路径关闭学习。共用
# tune_runtime_enabled、tune_min_repeats 和 tune_runtime_sample_limit。

# baby_backend = "coop32"  # string: [auto|scalar|coop32]
# CUDA defaults to coop32 for baby ladders at arithmetic widths 8193..16384 bits when device baby
# generation is available. Other shapes use scalar. Explicit auto uses checked paired tune results,
# starting with scalar. CLI --baby-backend overrides TOML. If omitted, an explicit NTT_BABY_COOP
# takes precedence. Legacy cost profiles default to scalar. OpenCL uses scalar.
# CUDA 默认在实际算术位宽 8193..16384 bits 且设备 baby 生成可用时使用 coop32，其他形状使用标量。显式
# auto 从标量起步，依据通过校验的配对 tune 结果选择。CLI --baby-backend 覆盖 TOML。省略此键时优先使
# 用显式 NTT_BABY_COOP。旧成本配置默认使用标量，OpenCL 使用标量。

# giant_backend = "coop32"  # string: [auto|scalar|coop16|coop32]
# CUDA defaults to coop32 for eligible giant chains at arithmetic widths 8193..16384 bits. coop16
# uses a fixed 16384-bit container, while coop32 uses width-matched containers. Explicit auto uses
# checked paired tune results, starting with scalar. CLI --giant-backend overrides TOML. If omitted,
# an explicit NTT_GIANT_COOP takes precedence. Legacy cost profiles default to scalar. OpenCL uses
# scalar.
# CUDA 默认在实际算术位宽 8193..16384 bits 且可走递推链时使用 coop32。coop16 使用固定 16384-bit 容
# 器，coop32 按位宽分档。显式 auto 从标量起步，依据通过校验的配对 tune 结果选择。CLI --giant-backend
# 覆盖 TOML。省略此键时优先使用显式 NTT_GIANT_COOP。旧成本配置默认使用标量，OpenCL 使用标量。

# seed_backend = "coop32"  # string: [auto|scalar|coop32]
# CUDA defaults to coop32 for paired seeds and GPU [D]Q at arithmetic widths 8193..16384 bits when
# the paired-seed path is used. Explicit auto uses checked paired tune results, starting with
# scalar. CLI --seed-backend overrides TOML. If omitted, an explicit NTT_GIANT_SEED_COOP takes
# precedence. Legacy cost profiles default to scalar. OpenCL uses scalar.
# CUDA 默认在实际算术位宽 8193..16384 bits 且使用成对种子时，以 coop32 生成种子和设备端 [D]Q。显式
# auto 从标量起步，依据通过校验的配对 tune 结果选择。CLI --seed-backend 覆盖 TOML。省略此键时优先使
# 用显式 NTT_GIANT_SEED_COOP。旧成本配置默认使用标量，OpenCL 使用标量。

# reduce_backend = "auto"  # string: [auto|scalar|coop32]
# Ordinary S4 coefficient cpu_simd_reduction: auto keeps scalar until repeated same-shape
# comparisons qualify coop32, then uses the fastest checked total including point startup checks. At
# fixed D/layout/chain/point backends, it adds at most one missing cooperative variant at a time
# (two-pass or merged), then extends D after checked comparisons. CUDA arithmetic widths 8193..16384
# bits can use shared warp remainders; smaller widths and exact Mersenne cpu_simd_reduction keep
# their kernels. Actual reduce_coop, threads and kernel identity stay separate in ECM timing rows
# even if environment matching is ignored; standalone NTT tables remain reusable. CLI
# --reduce-backend overrides this worker key; omission preserves explicit NTT_S4_COOP_REDUCE=0|32.
# OpenCL uses scalar.
# 普通S4逐系数归约：默认auto，在同形状重复对照合格前保留scalar，再按含点启动检查的实测总耗时选择最快
# 项。每个算术家族固定D／布局／链长／点后端，每次仅增加一个缺少的协作变体（两遍／合并），完成有效对
# 照后再继续D搜索。CUDA实际算术8193..16384 bits可使用共享余数；较小位宽和精确梅森归约保持原内核。实
# 际reduce_coop、线程块与内核身份按ECM每行独立记账，即使忽略environment也不混合，独立NTT表继续复用。
# CLI --reduce-backend覆盖当前worker；省略时保留显式NTT_S4_COOP_REDUCE=0|32。OpenCL实际为scalar。

# groot_balanced = "auto"  # bool|string: [auto|false|true|0|1]
# G-root polynomial layout. "auto" uses the qualified NTT-cliff model and measured tuning; true
# forces the balanced tile layout, false forces the contiguous layout. Default "auto". This does not
# rebalance giant point chunks or change B2/D/P. CUDA only; OpenCL accepts "auto". CLI
# --groot-layout auto|true|false overrides this worker TOML; numeric CLI aliases 0/1 remain
# supported. Tune rows store the resolved layout as 0/1.
# G根多项式布局："auto"按已验证的NTT拐点模型及实测tune选型，true强制分块均衡布局，false强制连续布
# 局，默认"auto"。不改变giant点块划分或B2/D/P。仅CUDA支持强制布局，OpenCL接受"auto"。CLI
# --groot-layout auto|true|false覆盖当前worker配置，并保留CLI 0/1别名；tune行记录实际布局0/1。

# groot_subtree = "1[:3072], 0[8192:], auto[]"  # int|string: [auto|-1|0|1|slice list]
# CUDA Stage2 G-tree subtrees. 0 disables, 1 enables four-root subtrees for supported native or
# carrier Mersenne arithmetic, and auto or -1 uses matching ECM tune results. Auto uses the original
# path until both modes have qualified results. Ordered slices match the actual cofactor width,
# including the start and excluding the end. CLI --groot-subtree overrides this policy. Other
# arithmetic paths use the original tree.
# CUDA Stage2 G 树子树策略。0 关闭，1 对支持的原生或承载梅森算术开启四根子树，auto 或 -1 按匹配的
# ECM tune 结果选择。自动模式在两种模式均有合格结果前走原路径。切片按实际余因子位宽依次匹配，含起
# 点、不含终点。命令行 --groot-subtree 优先。其他算术路径沿用原树。

# giant_tail_balance = false  # bool: [false|true|0|1]
# Allow the last two giant point chunks to borrow whole P batches so both can use chains. B2,
# capacity, coverage and chunk count are unchanged. Default false. No actual borrow keeps the
# original cost/cache identity and avoids extra replay or synchronization. Actual borrowing keeps an
# independent tune identity and replays the original interval on a hit/nonunit; that replay may need
# more workspace. CLI --giant-tail-balance overrides this worker TOML.
# 允许完整giant区间的末两点块借整P批次，使两块均可走chain；不改变B2、容量、覆盖及块数。默认false。未
# 实际借块时沿用原成本及缓存身份，不增加重放或同步；实际借块独立记录tune，命中或非单位时重放原区间，
# 重放可能需要更大工作区。CLI --giant-tail-balance覆盖当前worker配置。

# b2_round_chain = true  # bool: [false|true|0|1]
# Round B2 per candidate D. CPU gwpoly fills the existing last P-point G block after relocation.
# CUDA also requires a chain-capable final point chunk. Tuning measures each candidate at its actual
# B2. Logs and internal results retain both bounds. Enabled by default for CPU gwpoly ABI 4 and CUDA
# full-interval runs. Set false to keep the requested bound. CPU libecm, older DLLs, CUDA relocation
# and calibration use fixed bounds by default. Integer, memory and enabled AutoB2 limits apply. CUDA
# startup cost probes keep fixed bounds and explicit ECM calibration requires rounding off. CLI
# --b2-round-chain overrides this worker setting.
# 按候选 D 向上凑整 B2。CPU gwpoly 在确定高位后缀后补满已有的最后一个 P 点 G 块；CUDA 还要求尾点块能
# 走链。调优按实际 B2 采样，日志与内部结果记录请求和实际界限。CPU gwpoly ABI 4 和 CUDA 完整区间默认
# 开启，设为 false 保留请求界限。CPU libecm、旧 DLL、CUDA relocation 和标定默认使用固定界限。整数、
# 内存及启用的 AutoB2 上限仍生效。CUDA 启动探测使用固定界限，显式 ECM 标定要求关闭凑整。CLI
# --b2-round-chain 覆盖 worker 配置。

# giant_chain = "64"  # string: [64|32|auto]
# Points per sequential CUDA thread chain, independent of CUDA block size. 64 preserves the
# baseline; 32 explicitly selects shorter chains. auto retains 64 until tune_min_repeats admitted
# runtime observations support 32, with bounded useful-curve probes. Policies have separate tune
# identities. Hit/nonunit replays the legacy 64-point full interval. CLI --giant-chain overrides
# this worker TOML.
# 每条CUDA线程链连续生成的点数，与CUDA线程块大小无关。64保留基线，32显式使用短链；auto在满足
# tune_min_repeats门槛的准入实测支持32前保留64，并进行有界正常曲线探测。各策略具有独立tune身份。命中
# 或非单位时按旧64点链重放完整区间。CLI --giant-chain覆盖当前worker配置。

# relocation = false  # bool: [false|true|0|1]
# Optional production GPU Stage2 conservative relocation. Keeps B2 and the original giant endpoint,
# uses a shorter suffix for clean NF, and replays the original interval on any hit or target-N
# nonunit (including GCD=N). Rebalances short point chunks on whole G boundaries. Default 0
# preserves the original algorithm. CLI --relocation overrides this worker TOML. D/AutoB2 and memory
# admission use original-interval estimates; relocation does not collect ECM tune samples or run
# startup ECM calibration, and explicit --tune ecm is unavailable in this mode. Pure NTT samples
# remain reusable.
# 可选的生产 GPU Stage2 保守 relocation。保持 B2 和原 giant 终点，干净 NF 使用较短后缀；命中或出现目
# 标 N 非单位（包括 GCD=N）时重放原区间。短点块按完整 G 边界重分。默认 0 保留原算法，CLI
# --relocation 覆盖当前 worker 的 TOML。D/AutoB2 和内存准入使用原区间估算；本模式不采集 ECM 调优样
# 本、不执行启动 ECM 标定，并禁用显式 --tune ecm；纯 NTT 样本仍可复用。

# b2 = 0  # u64: <x:Z,x=0|B1<x<=2^63-1-8192>
# Stage2 upper bound when neither CLI nor task supplies a nonzero B2. 0 defers to other sources.
# Explicit B2 must exceed the save's B1. Larger B2 usually increases coverage, time, and VRAM
# demand. Precedence: nonzero CLI B2, then task B2, then this key.
# 设置未在命令行或任务行给出非零 B2 时使用的 Stage2 上界。0 表示继续从其他来源选择；显式 B2 必须大于
# 存档的 B1。增大 B2 通常增加搜索范围、运行时间及显存需求；命令行非零 B2 优先于任务行，任务行优先于
# 此键。

# d = 0  # u64: <x:Z,x=0|x>=6,x%2=0>
# Manual Stage2 step D. 0 selects the shape automatically. Explicit values must be even, at least 6,
# and satisfy the engine's layout constraints. D affects tree size, batch count, and memory demand;
# automatic selection is normally suitable.
# 手动指定 Stage2 算法步长 D。0 自动选形；非零值除满足偶数且不小于 6 外，还必须满足当前引擎的布局限
# 制。D 会改变树规模、批次数和内存需求，通常保持自动。

# s4_batch_mib = 64  # u64: <x:Z,1..2^20>
# Stage2 S4 batch-buffer budget in MiB. Larger budgets may reduce batching overhead but consume more
# VRAM. This limits the corresponding buffers, not total process VRAM.
# 设置 Stage2 S4 批次的工作缓冲预算，单位为 MiB。增大预算可能减少分批开销，但会占用更多显存；它只约
# 束对应批次缓冲，不是整个进程的显存上限。

# arena_mib = 0  # u64: <x:Z,0..2^20>
# Stage2 large-workspace budget in MiB, used to plan available NTT shapes. 0 uses environment
# settings or automatic planning, not zero VRAM. Too little may force smaller shapes or prevent
# execution. Tables, coordinates, and other modules may allocate additional VRAM.
# 设置 Stage2 大工作区预算，单位为 MiB，用于规划可用的 NTT 工作形状。0 由运行环境或自动规划决定，不
# 表示不使用显存；过小可能迫使较小工作形状或使任务无法运行。表、坐标和其他模块仍可能另占显存。

# fold_resident_mib = 640  # u64: <x:Z,0..2^20>
# Budget in MiB for keeping fold accumulators on the GPU. 0 disables this residency. Exceeding the
# budget may fall back to batching, substantially increasing processing and transfer costs.
# Independent of arena and batch budgets; not a total VRAM limit.
# 设置 fold 累积结果驻留 GPU 的预算，单位为 MiB。0 关闭这部分驻留；所需空间超过预算时可退回分批路
# 径，可能显著增加处理和传输开销。此预算与大工作区、批次缓冲分别控制，不是总显存限制。

# decompose_factors = false  # bool: [false|true|0|1]
# Further decompose found factors: 1 uses the shared diagnostic service (local PARI DLL first,
# external GP second); GMP is never selected automatically. 0 keeps only factors extracted and
# verified by Stage2. Only complete, proven decomposition sets factorization_complete. Unfinished
# diagnostics preserve the original factor and successful curve status.
# 控制命中因子的附加分解。1 使用共享诊断层，优先本地 PARI DLL，备选外部 GP，不自动使用 GMP 算法；0
# 只保留 Stage2 已得到并验证的因子。仅完整且全部已证素的分解标为完成；诊断未完成仍保留原始因子与曲线
# 成功状态。

# skip_prime_attribution = false  # bool: [false|true|0|1]
# Skip diagnostic prime attribution, which identifies Stage2 primes responsible for a hit. 1 skips
# attribution while retaining factor extraction and validation; 0 follows the engine's diagnostic
# policy. This does not disable decomposition or change decompose_factors.
# 控制是否跳过命中结果的素数归因诊断，即查找哪些 Stage2 素数对应此次命中。1 跳过此诊断，仍执行因子提
# 取与验证；0 使用引擎默认诊断策略。此键不表示关闭因子分解，也不改变 decompose_factors。

# auto_b2 = false  # bool: [false|true|0|1]
# Choose B2 when every source supplies zero. 1 optimizes workflow benefit per time including Stage1
# cost; 0 disables. Requires usable Stage2 costs and positive Stage1 s/curve. B1 never gates tune
# reuse; tune_ignore controls other conditions. Memory and carrier divisibility are checked on the
# current input. Estimates retain uncertainty labels; the legacy .cprof interface keeps its original
# qualification checks.
# 所有来源均为零 B2 时自动选择。1 按计入 Stage1 成本的全流程单位时间收益选取；0 关闭。须有可用
# Stage2 成本与正的 Stage1 秒/曲线。B1 不作为 tune 复用门槛；其他条件由 tune_ignore 控制。当前输入仍
# 检查显存及承载整除关系；估算保留不确定性标记，旧 .cprof 接口保持原资格检查。

# gp = ""  # string: <exe>
# External PARI/GP fallback executable for optional factor decomposition. The local PARI DLL is
# tried first. gp.stage1_exe follows Windows executable search rules; a full path is accepted. GP
# failure preserves partial PARI results and never enables GMP automatically. Dataset scripts retain
# their separate --gp resolution rules.
# 指定附加因子分解的外部 PARI/GP 备选程序，默认先使用本地 PARI DLL。gp.stage1_exe 按 Windows 程序搜
# 索规则查找，也接受完整路径。GP 失败保留 PARI 部分结果，不自动使用 GMP；数据集脚本继续使用各自的
# --gp 路径规则。

# factor_timeout_seconds = 30  # u64: <x:Z,1..600>
# Timeout in seconds for each external GP fallback decomposition call. Local PARI calls have a
# 5-second process deadline and a 10-second cumulative session budget per curve worker. Explicit GMP
# analysis remains bounded to 2 seconds per call. These diagnostics never change the original factor
# or successful Stage2 computation status.
# 设置备选外部 GP 分解调用的超时秒数。本地 PARI 单次进程限 5 秒、单曲线 worker 会话累计限 10 秒；显
# 式选择 GMP 时单次限 2 秒。附加诊断不改变原始因子或 Stage2 成功状态。

# tune_legacy_cost_profile = ""  # string: <path>
# Legacy .cprof cost profile for Auto B2 when stage2_tune_profile is empty. Checks the original
# binary/device/arithmetic and calibration contract; new full ECM tune does not relax those checks.
# Empty supplies no legacy profile.
# stage2_tune_profile 为空时供 Auto B2 使用的旧 .cprof 成本配置。保持原二进制、设备、算术及标定资格
# 检查；新的完整 ECM tune 不放宽旧合同。留空不提供旧配置。

# auto_carrier = true  # bool: [false|true|0|1]
# Add M=2^p-1 for validated ECMSTAGE2=1,2,p,-1 saves when N divides M and 2<=p<=16384. Compare
# ordinary cost at target_bits with Mersenne cost at arithmetic_bits=p, using prediction_policy.
# Full M_p already has native Mersenne arithmetic. Explicit carrier options take process_priority; a
# cofactor save needs a matching task to infer p.
# 对有效ECMSTAGE2=1,2,p,-1保存点，验证N整除M=2^p-1且2<=p<=16384后加入承载候选。普通成本按target_bits
# 、梅森成本按arithmetic_bits=p查询，并遵循prediction_policy；完整M_p已使用原生梅森算术，不重复加入
# 相同候选。显式承载选项优先；余因子save须匹配任务才能推断p。

# prediction_policy = "model"  # string: [model|paired]
# model: prefer exact paired measurements, otherwise compare generic and Mersenne arithmetic-width
# region estimates with two-sided uncertainty and current memory admission. Missing tune data uses
# an explicitly estimated 4060-Laptop/1800-MHz basic model. Uncovered NTT/residency regions retain
# the default. paired: require the original exact-width/B2 measured win. B1 never gates reuse.
# model：优先使用精确配对实测；其他输入分别按通用、梅森算术位宽区间预测，满足双侧误差保护及当前显存
# 准入才替换。缺调优资料时使用明确标为估算的4060 Laptop/1800MHz基础模型；未覆盖的NTT/驻留区间保留默
# 认。paired恢复原精确位宽/B2实测收益门禁。B1不作为复用门槛。

# tune_arithmetic = "both"  # string: [both|generic|mersenne]
# Arithmetic families for explicit width-grid ECM tune: both, generic probable-prime N, or Mersenne
# 2^p-1 arithmetic after stripping proper-exponent inherited factors and small target divisors. p is
# the requested grid arithmetic width; actual cofactor width is recorded separately. Real
# worktodo_file/save pairs continue to follow auto_carrier. Invalid or factor-producing synthetic
# Mersenne fixtures are skipped, never saved as timing measurements.
# 显式位宽网格ECM tune的算术家族：both同时测量；generic使用通用可能素数；mersenne使用去除真因子指数
# 继承因子及小因子后的2^p-1承载算术。p为网格要求的算术位宽，实际余因子位宽另行记录。真实
# worktodo_file/save配对仍遵循auto_carrier；无效或产生因子的合成梅森样本跳过，不写成计时数据。

# tune_runtime_enabled = true  # bool: [false|true|0|1]
# CUDA Stage1 NTT tunes missing widths before production and uses read-only selection when disabled.
# Stage2 CUDA accumulates checked no-factor production timings by device, environment and execution
# shape. Identical complete parameters share one matrix row with repeats, mean time and sample
# standard deviation. Slower observations count too. Row version and UTC update time record
# provenance only. Software upgrades retain compatible timings. Model selection tests a legal
# Mersenne carrier first, then ordinary and promising D candidates. Candidates that reach
# tune_min_repeats are ranked by the fastest mean. B1 does not gate CUDA cost reuse. CPU GWNUM
# records timings in the [cpu_stage2] matrix and can reuse a matching FFT and F-tree plan across
# widths and memory budgets after preflight. Writes are locked and atomic. Cache failure does not
# fail a completed curve. false disables single-curve runtime trials, collection and writes. CPU can
# still read qualified observations. Parallel queue decisions use curve_concurrency. OpenCL learns
# point plans in opencl_tune_file at fixed geometry.
# CUDA Stage1 NTT 在生产前补测缺失位宽，关闭时只读选型。Stage2 CUDA 按设备、环境与执行形状累计通过检
# 查的无因子生产计时。完全相同参数合并为一条 matrix 记录，保存 repeats、平均耗时和样本标准差，包含较
# 慢观察。行内版本与 UTC 更新时间仅记录来源，程序升级保留兼容计时。model 选型优先试跑合法梅森承载，
# 再比较普通路径和有希望的 D。达到 tune_min_repeats 后采用实测最快均值。B1 不限制 CUDA 成本复用。CPU
# GWNUM 把耗时写入 [cpu_stage2] 矩阵。预检确认 FFT 和 F 树方案一致时，可跨位宽和内存预算复用。写入使
# 用共享锁和原子替换，缓存失败不影响已完成的曲线。false 关闭单曲线试跑、采集和写回，CPU 仍可只读复用
# 合格记录。双槽队列由 curve_concurrency 控制。OpenCL 固定几何，在 opencl_tune_file 中学习点计划。

# curve_concurrency = "serial"  # string: [auto|serial|dual]
# CUDA Stage2 curve scheduling. auto measures serial and eligible dual-slot modes. serial is the
# default. dual requests two slots subject to device admission. CLI: --parallel auto|0|1|2.
# CUDA Stage2 曲线调度。auto 实测串行和可准入的双槽模式。默认 serial 串行执行，dual 请求双槽并检查显
# 存准入。命令行仍使用 --parallel auto|0|1|2。

# workspace_policy = "auto"  # string: [auto|independent|leased]
# independent gives each CUDA Stage2 slot a workspace. leased lets the second slot prepare and
# compute baby points before leasing the heavy workspace at the F-tree boundary. auto compares both
# and uses leased directly if only it fits.
# independent 为两个 CUDA Stage2 槽分别分配工作区。leased 允许下一槽先准备和计算 Baby 点，到 F 树前
# 再租用大工作区。auto 比较两种模式，只有租约可准入时直接使用 leased。

# parallel_tune_curves = 5  # u64: [2..16]
# Number of curves in each CUDA Stage2 queue tuning window. Windows of 2 to 4 curves compare
# full-window throughput. Longer windows also check steady-state completion throughput.
# CUDA Stage2 每个队列调优窗口的曲线数。2 至 4 条按整窗吞吐比较，5 条及以上还检查中段完成吞吐。

# tune_min_repeats = 2  # u64: [1..1000]
# Minimum checked observations required before runtime D, layout and chain candidates are compared
# or adopted. Also sets the minimum ECM calibration repeat count; --tune-repeats may request more.
# Default 2; 1 enables faster screening with no measured dispersion. Must not exceed
# tune_runtime_sample_limit. Existing observations are retained; increasing this minimum requires
# additional evidence. Arithmetic validation is unchanged. CLI: --tune-min-repeats N.
# 运行时D、布局与链长候选比较和采用所需的最少已校验观察数，同时作为ECM校准最小重复次数；
# --tune-repeats可要求更多。默认2；设为1用于快速筛查，但无法测得离散程度。不得超过
# tune_runtime_sample_limit；已有观察保留，提高门槛后需补足证据。算术验证不变。
# CLI：--tune-min-repeats N。

# tune_runtime_sample_limit = 10  # u64: [1..1000]
# Maximum independent runtime NF observations per identical complete parameters (including B1) and
# matching device/environment/arithmetic/path, including slower observations and compatible software
# versions. Identical parameters merge into repeats and mean/stddev; the limit counts observations,
# not matrix rows. Different parameter rows are retained. Selection requires tune_min_repeats
# observations. Lowering this limit preserves existing evidence. CLI: --tune-runtime-samples N.
# 完全相同参数（含B1）及相同设备、环境、算术和执行形状的独立运行NF观察上限，包含较慢观察及可兼容的其
# 他程序版本。相同参数合并repeats和均值/标准差；上限统计观察次数，不统计matrix行数；不同参数行保留。
# 达到tune_min_repeats次后可用于实测选型；调低上限不删除已有证据。CLI：--tune-runtime-samples N。

# short_ntt_batch_tune = false  # bool: [false|true|0|1]
# Experimental short NTT batch selection from stage2_tune_profile, for lengths up to 2^19. Minimizes
# estimated convolution time including the tail, within the current chunk budget; requires at least
# two measured batch sizes and a predicted gain above 10%. Does not tune kernel configuration. Pure
# NTT gains do not guarantee faster full Stage2; default false pending full-engine validation.
# 实验性短 NTT 批量选择：读取 stage2_tune_profile，作用于不超过 2^19 的长度。在当前分块预算内按含尾
# 批的预计卷积总时间选型；至少需要两个实测 batch，预计收益须超过 10%。不改变内核配置。纯 NTT 收益不
# 保证完整 Stage2 更快；完成整机验证前默认 false。

# low_cpu_wait = false  # bool: [false|true|0|1]
# Opt-in low CPU policy: CUDA blocking device scheduling (4) and bounded event polling. Blocking
# reads keep their native path; elapsed time may increase.
# Default false selects auto scheduling (0) and native event waits. CLI --low-cpu-wait 0|1 overrides
# this key.
# An explicit key sets NTT_CUDA_WAIT_MODE and NTT_HOST_EVENT_WAIT, and clears
# NTT_HOST_READBACK_WAIT. Omission preserves expert environment overrides. FIFO recycling is
# independent.
# 可选低CPU策略：CUDA设备阻塞调度（4）配合事件退避轮询；同步读回保持原路径，可能增加耗时。
# 默认false：自动调度（0）和原生事件等待。命令行--low-cpu-wait 0|1优先，FIFO回收独立生效。
# 显式配置设置NTT_CUDA_WAIT_MODE、NTT_HOST_EVENT_WAIT，并关闭NTT_HOST_READBACK_WAIT。
# 未配置时保留专家环境覆盖；读回前休眠可单独实验。

# pack_zero = true  # bool: [false|true|0|1]
# Fuse input digit packing and zero padding in one GPU kernel per operand. Covers contiguous,
# resident gather and reverse inputs. Other shapes use the original packer. CLI --pack-zero
# overrides this key. Legacy .cprof cost profiles default to false and require false when set
# explicitly.
# 每个操作数用一个 GPU 内核完成 digit 打包和补零，覆盖连续输入、设备驻留 gather 及反向输入。其余形状
# 使用原打包路径。命令行 --pack-zero 优先于本键。旧 .cprof 成本配置默认使用 false，显式配置时也须设
# 为 false。

# weighted_ntt = false  # bool: [false|true|0|1]
# Opt-in polynomial convolution for the production CUDA backend. Fuses the first DIF stage into
# direct digit packing and reconstructs both halves in the final inverse stage. Requires pack_zero.
# Calls without cached roots or direct device packing use the full-length path. The TOML preset
# stays inactive on OpenCL. CLI --weighted-ntt 0|1 overrides this key.
# 生产 CUDA 后端可启用的多项式卷积。直接打包时融合首层 DIF，逆变换末层重建高低两半。需启用 pack_zero
# 。没有缓存根表或直接设备打包的调用使用全长路径。OpenCL 不启用该 TOML 预设。命令行 --weighted-ntt
# 0|1 优先。

# ntt_two_axis = true  # bool: [false|true|0|1]
# Enable two-axis NTT for eligible CUDA Stage2 products in the F and G trees, Newton inverse, H
# fold, and descent. Eligibility requires a Mersenne carrier, a supported shape, and available
# device memory. Single-axis NTT handles other products and legacy cost profiles. CLI --two-axis-ntt
# 0|1 overrides this key. The setting is inactive on OpenCL.
# 统一控制 CUDA Stage2 的 F 树、G 树、Newton 倒数、H fold 和下降是否使用双轴 NTT。双轴路径要求梅森承
# 载、受支持的形状和可用显存。其余乘积及旧成本配置使用单轴。命令行 --two-axis-ntt 0|1 优先。此选项在
# OpenCL 上不生效。

# tune_stage1_cost_file = ""  # string: <path>
# Checked completed CUDA Stage1 cost anchors, used after explicit seconds/curve and CSV. Matches
# batch, modulus type and exponent; B1 and missing widths scale by B1 and the dispatched container
# squared. Device/runtime reuse follows tune_ignore. This does not run Stage1.
# 已核验的完整 CUDA Stage1 成本锚点，优先级低于显式秒/曲线和 CSV。匹配批次、模数类型和指数模式；B1
# 与缺失位宽按 B1 和容器位宽平方估算。设备及运行时复用遵守 tune_ignore；此文件不启动 Stage1。

# auto_min_b2 = 0  # u64: <x:Z,0..2^63-8193>
# Auto B2 lower search bound; 0 means B1+1. Unmeasured values may be estimated; explicit task B2
# takes precedence.
# Auto B2 搜索下界；0 为 B1+1。未测值允许估算，显式任务 B2 优先。

# auto_max_b2 = 0  # u64: <x:Z,0..2^63-8193>
# Auto B2 upper search bound; 0 means 2.6e12. Unmeasured values may be estimated; explicit task B2
# takes precedence.
# Auto B2 搜索上界；0 为 2.6e12。未测值允许估算，显式任务 B2 优先。

# tune_stage1_batch = 1  # u64: <x:Z,1..2^20>
# Stage1 batch curve count associated with Auto B2 cost estimation. Selects or checks Stage1 cost
# conditions; it neither starts a Stage1 batch from Stage2 nor changes the assignment's curve count.
# 指定 Auto B2 成本估算对应的 Stage1 批次曲线数。它用于选择或核对 Stage1 的成本条件，不会让 Stage2
# 驱动启动该批 Stage1 计算，也不改变任务要处理的曲线数。

# tune_stage1_seconds_per_curve = 0  # double: <x:R,finite,x>=0>
# Stage1 seconds per curve for Auto B2, already amortized for the actual batch. A positive value,
# including a decimal, overrides the Stage1 cost from tuning data. Set 0 or omit this option to use
# the configured Stage1 cost sources. Full ECM tune can use a cost CSV or a matching
# tune_stage1_cost_file. The legacy component profile uses its own matched Stage1 data. This value
# is a planning input.
# 为 Auto B2 提供 Stage1 每曲线秒数，按实际批次摊销，无需再除以 tune_stage1_batch。正值（可填小数）
# 优先于调优数据中的 Stage1 成本。设为 0 或省略时，使用已配置的 Stage1 成本来源。完整 ECM tune 可使
# 用成本 CSV 或匹配的 tune_stage1_cost_file。旧组件 profile 使用其自身匹配的 Stage1 数据。该值用于成
# 本规划。

# ratio_adjust = 1  # double: <x:R,finite,x>0>
# Multiplier applied to Stage2 time in the Auto B2 model. 1 leaves it unchanged; greater than 1
# estimates higher cost, less than 1 lower cost, usually changing selected B2. Adjusts planning
# cost, not actual GPU speed.
# 将 Auto B2 模型中的 Stage2 时间乘以该系数。1 不调整，大于 1 表示估计 Stage2 更贵，小于 1 表示更便
# 宜；通常会相应影响所选 B2。此键只调整选形成本，不会让 GPU 按比例变快或变慢。

# tune_ignore = "gpu,driver,cuda,backend,environment"  # string: [gpu|driver|cuda|backend|memory|environment],...
# Comma-separated conditions ignored for profile reuse. Empty enforces every condition. Memory
# normally matches execution path; arithmetic legality and current memory admission are always
# checked.
# 逗号分隔的复用忽略项；留空核对全部条件。memory 默认匹配执行路径。算术合法性及当前显存准入始终检
# 查。

# tune_budget_seconds = 1800  # u64: <x:Z,1..86400>
# Tuning budget including input preparation, measurements and optional warmups. Start each width/B2
# at the default model's D, compare neighbors, and follow only measured improvements above 2% plus
# the MAD noise margin. Reuse completed candidates. Finish an in-flight measurement after the
# deadline and retain valid summaries.
# 调优预算，包含输入准备、测量及显式开启的预热。每个位宽/B2 从默认模型的 D 开始比较邻档，仅沿超过 2%
# 且跨过 MAD 噪声界限的实测收益移动。复用已测候选；到期完成正在运行的测量并保留有效摘要。

# tune_warmup = false  # bool: [false|true|0|1]
# 0 starts formal ECM/NTT tuning and startup calibration without a discarded warmup. 1 runs one
# checked warmup per shape before formal repeats; it consumes the same budget and is excluded from
# the median/MAD. CLI --tune-warmup 0|1 overrides this key. Mandatory arithmetic checks are always
# performed.
# 0 表示 ECM/NTT 调优及启动短校准直接开始正式测量，不执行丢弃的预热轮次；1 表示每个形状先运行一轮经
# 过核验的预热，占用相同预算但不计入中位数/MAD。CLI --tune-warmup 0|1 覆盖此键；必要算术检查始终执
# 行。

# short_calibration = true  # bool: [false|true|0|1]
# Calibrate once when no suitable ECM tune file exists, required components are missing, or the task
# has no reusable calibrated width coverage. Partial coverage permits estimates.
# 无合适 ECM tune 文件、必要组件缺失或任务位宽完全没有可复用校准覆盖时短校准；部分覆盖允许估算。

# short_calibration_seconds = 10  # u64: <x:Z,1..600>
# Short calibration measurement budget, excluding first CUDA initialization; finish the current
# measurement before stopping.
# 短校准测量预算，不含首次 CUDA 初始化；到期完成当前测量后停止。

# tune_error_limit = 0.08  # double: <x:R,0<x<=1>
# Relative error limit for qualifying the nonnegative full-curve cost model by leave-one-out
# validation. Sparse estimates keep uncertainty labels and cannot override the default D. Local
# descent compares measured medians and MAD rather than prediction error.
# 非负完整曲线成本模型的留一验证相对误差门限。稀疏估算保留不确定性标记，不能覆盖默认 D；局部下降比较
# 实测中位数与 MAD，不用预测误差决定移动。

# tune_stage1_cost_csv = ""  # string: <path>
# CSV Stage1 s/curve anchors for workflow Auto B2. Columns: container_bits or target_bits,
# opencl_threads_per_integer, curves, b1, mhz, seconds_per_curve; optional tpb and exponent. Missing
# widths may interpolate or extrapolate. Costs are already amortized.
# 总流程 Auto B2 的 Stage1 秒/曲线 CSV；列为 container_bits 或 target_bits、
# opencl_threads_per_integer、curves、b1、mhz、seconds_per_curve；可选 tpb、exponent。缺失位宽可插值
# 或外推，成本已摊销。

# tune_stage1_cost_mhz = 0  # u64: <x:Z,0..10000>
# Stage1 target frequency for inverse-frequency cost scaling. 0 uses the CSV reference frequency;
# this does not change GPU clocks.
# Stage1 成本反频率缩放的目标频率；0 使用 CSV 参考频率，不修改 GPU 时钟。

# target_factor_bits = 0  # u64: <x:Z,0|2..16384>
# Target prime-factor size for Dickman semismooth success probability. 0 derives a recommendation
# from B1; this is distinct from the full modulus size.
# Dickman 半光滑成功概率的目标素因子位数；0 根据 B1 推荐，与完整模数位宽不同。

# tune_condition_tag = ""  # string: <text>
# Optional measurement-condition label, e.g. a fixed clock or power setting. Distinct labels
# preserve separate fastest summaries; ignored environment allows reuse.
# 可选测量条件标签，例如固定频率或功耗。不同标签保留独立最快汇总；忽略 environment 时允许复用。

[gui]
# gpu_clock_ranges = ""  # string: <GPU-UUID:minMHz-maxMHz[:auto];...>
# GUI v2 GPU core-clock drafts keyed by NVML GPU UUID: GPU-<UUID>:minMHz-maxMHz, separated by
# semicolons. Optional :auto enables one startup apply, every local whole hour, and a one-shot
# reapply after each continuous 5-second out-of-range episode. Detection reuses the monitor samples.
# Without :auto, loading never changes hardware. Saving does not apply drafts in this session; Apply
# activates the draft range and auto option. Reset disables auto in this session without erasing
# saved drafts. Empty saves none; worker computation settings are unaffected.
# GUI v2 的 GPU 核心频率草稿：GPU-<UUID>:最小MHz-最大MHz，多卡用分号分隔。可选 :auto 启用启动时一
# 次、每个本地整点、以及每次连续越界 5 秒后的单次自动应用；检测复用监控采样。无 :auto 时载入不修改硬
# 件。保存不应用本次草稿；点击应用才启用本次范围和自动选项。恢复默认关闭本次会话自动应用，不删除保存
# 草稿。空值不保存范围，不改变 worker 计算配置。

# pause_schedule = []  # string_array: ["application, Worker, weekday, time", ...]
# GUI v2 local-time pause rules. Each item has application, Worker, weekday and time groups.
# Example: ["foobar, [1,3-5], Mon-Fri, 08:30-17:30"]. Application names match a running program's
# path substring regardless of case. Use * for time-only rules, or an empty array to disable
# scheduling.
# GUI v2 暂停规则。每项依次填写应用、Worker、星期、时间。例如 ["foobar, [1,3-5], Mon-Fri,
# 08:30-17:30"]。应用按运行程序路径的子串匹配，忽略大小写。仅按时间暂停时使用 *。空数组关闭计划。

# results_last_copy_utc = ""  # string: <YYYY-MM-DD HH:MM:SS UTC>
# Last successful JSON result copy in GUI v2, recorded in UTC. Empty means no copy time has been
# recorded.
# GUI v2 上次成功复制 JSON 结果的 UTC 时间。留空表示尚未记录复制时间。

# stage1_exe = ""  # string: <exe>
# Stage1 worker executable. Relative paths resolve beside the GUI; bare names can use PATH. Empty
# searches ecm_cuda.stage1_exe then ecm.stage1_exe. The worktodo_file prefix selects this executable
# or stage2_exe for each worker.
# Stage1 工作程序。相对路径以 GUI 目录为基准，单独文件名也可经 PATH 查找；留空依次查找
# ecm_cuda.stage1_exe、ecm.stage1_exe。每个 worker 根据 worktodo_file 前缀选择此程序或 stage2_exe。

# stage2_exe = ""  # string: <exe>
# Stage2 executable for CPU, CUDA or OpenCL. Empty searches ecm_stage2.stage1_exe, then legacy
# ecm_cuda_stage2.stage1_exe, ecm_cpu_stage2.stage1_exe and ecm_opencl_stage2.stage1_exe in the
# workflow and GUI directories. A single matching child package can also be discovered. Set an
# explicit path to choose between installed packages.
# CPU、CUDA 或 OpenCL 的 Stage2 程序。留空时在工作流和 GUI 目录依次查找 ecm_stage2.stage1_exe、
# ecm_cuda_stage2.stage1_exe、ecm_cpu_stage2.stage1_exe 和 ecm_opencl_stage2.stage1_exe，也支持唯一
# 匹配的子包。安装多个子包时可用路径指定后端。

# language = "english"  # string: <xml-stem>
# GUI language, specified by the language XML filename stem in localization, without .xml. Missing
# resources or unavailable glyphs follow the GUI's display fallback rules.
# 选择 GUI 界面语言，值为 localization 目录下语言 XML 文件的文件名主体，不带 .xml。找不到所需资源或
# 字体不能显示该语言时，按 GUI 的回退规则使用可显示的界面。

# localization_dir = ""  # string: <dir>
# Directory containing GUI language XML files. Empty uses localization beside the GUI executable.
# Development builds also try the source-tree language resources.
# 指定 GUI 语言 XML 文件目录。留空使用 GUI 可执行文件旁的 localization 目录；从开发构建目录运行时还
# 会尝试源码中的语言资源目录。

# font = ""  # string: <ttf|ttc>
# GUI .ttf or .ttc font file. Empty selects a system font for the interface language. A Chinese
# interface requires a font with Chinese glyphs.
# 指定 GUI 使用的 .ttf 或 .ttc 字体文件。留空由程序按界面语言选择系统字体；需要中文界面时应使用包含
# 中文字形的字体。

# font_size = "auto"  # float|string: [auto|<x:R,6..96>]
# GUI font size in pixels; fractional values are accepted. auto or empty selects 15*DPI scale.
# Values below 6 or nonfinite values restore auto; values above 96 clamp to 96. Manual sizes bypass
# automatic sizing.
# 设置 GUI 字号，单位为像素，可使用小数。auto 或空值按 15*DPI 比例自动选择；小于 6 或非有限数恢复自
# 动，大于 96 按 96 处理。手动字号不会再按自动规则选择大小。

# font_snap = true  # bool: [false|true|0|1]
# Snap glyphs to the pixel grid: 1 enables, 0 disables. Compare clarity at fractional sizes or
# different DPI scales. off, false, and no also disable; other values enable. String matching is
# case-sensitive.
# 控制字体是否对齐像素网格。1 开启，0 关闭；小数字号或不同 DPI 下可比较显示清晰度。兼容 off、false、
# no 关闭，其他值按开启处理，字符串区分大小写。

# refresh_hz = 10  # int: <x:Z,1..60>
# Idle GUI frame and worker-status refresh target in Hz. Input messages wake the GUI promptly;
# higher values smooth charts and status updates at additional UI cost. GPU metrics are sampled
# independently at gpu_poll_ms, and neither setting changes computation speed.
# GUI 空闲时绘制帧与 worker 状态处理的目标频率，单位为 Hz。输入消息会及时唤醒界面；提高此值可使图表
# 和状态显示更平滑，但增加界面开销。GPU 指标按 gpu_poll_ms 独立采样，两项设置均不改变计算速度。

# gpu_poll_ms = 500  # int: <x:Z,100..2^31-1>
# GPU monitoring interval in milliseconds, at least 100. Larger values reduce NVML polling
# frequency. Affects monitoring updates only, not compute-kernel scheduling.
# 设置 GPU 监控查询间隔，单位为毫秒，最小为 100。增大可减少 NVML 查询频率；此键只影响监控数据更新，
# 不控制计算 kernel 的调度。

# process_priority = "below_normal"  # string: [idle|below_normal|normal|above_normal|high]
# Priority of worker processes launched by the GUI. below_normal is the default; lower
# process_priority makes concurrent desktop use easier. This is not a GPU exclusivity or utilization
# setting.
# 设置 GUI 启动的 worker 进程优先级。below_normal 为默认，较低优先级便于同时使用电脑；此键不是 GPU
# 独占或显卡占用率设置。

# window = [120, 80, 1500, 900]  # rect: <x:Z>,<y:Z>,<w:Z>,<h:Z>
# Saved main-window geometry: x,y,width,height. Updated on normal GUI exit; manual editing is
# usually unnecessary. Width and height should be positive.
# 保存 GUI 主窗口的位置和大小，依次为 x,y,宽,高。GUI 正常退出时会更新；通常无需手动编辑，宽和高应为
# 正数。

# dock_layout = ""  # string: <escaped_blob>
# Escaped GUI docking-layout data. Empty uses the default layout; the GUI writes it automatically.
# Incomplete manual edits may prevent layout restoration.
# 保存 GUI 面板停靠布局的转义数据。留空使用默认布局；由 GUI 自动写回，手动修改不完整数据可能使布局无
# 法恢复。

# dock_layout_ver = 0  # int: <x:Z,x>=0>
# Version of the saved docking layout, managed by the GUI. Older layouts are rebuilt using the
# current default. This does not select a GUI feature version.
# 保存已写入布局的版本编号，由 GUI 管理。版本早于当前默认布局时会重建布局；此键不是用户选择 GUI 功能
# 版本的开关。

# start_tab = "workers"  # string: [workers|detail|gen|prob]
# Panel initially shown by the GUI: workers opens the worker list, detail the details panel, gen the
# task generator, and prob the ECM probability calculator. The probability panel can also be opened
# from View. Does not change worker autostart behavior.
# 选择 GUI 启动时优先显示的面板。workers 为 worker 列表，detail 为详情，gen 为任务生成器，prob 为ECM
# 概率计算器；概率面板也可从查看菜单打开。不改变是否自动启动 worker。

# exit_confirm = "ask"  # string: [ask|stop|kill]
# Behavior when closing the GUI with active workers: ask prompts, stop requests a safe stop, kill
# terminates immediately. Stage1 saves a checkpoint; Stage2 finishes its current curve and records
# completed progress. Forced termination may lose the unfinished Stage1 work or current Stage2
# curve.
# 控制关闭GUI时如何处理运行中的worker：ask先询问，stop请求安全停止，kill立即终止。Stage1写检查点后退
# 出；Stage2完成当前曲线、记录完成进度后退出。强制终止可能丢失未存的Stage1计算或当前Stage2曲线。

# graceful_stop_ms = 300000  # i64: <x:Z,1000..3600000>
# Maximum wait in milliseconds after requesting a safe worker stop. Process exit ends the wait;
# workers still running at the deadline are terminated. Allow enough time for Stage1 checkpoint
# writes or the full current Stage2 curve. Stage2 curve counters are not intermediate arithmetic
# saves.
# 请求安全停止后等待的最长时间，单位毫秒。进程退出结束等待；到期仍运行的worker强制终止。应为Stage1检
# 查点写入或当前Stage2整条曲线留足时间；Stage2曲线计数不是中间算术存档。

# group_order_gp = ""  # string: <path-to-gp.exe|empty>
# External PARI/GP fallback executable for the Group Order Factor GUI. Auto tries the local PARI DLL
# first; empty searches gp in PATH only when GP is needed. GUI-only path setting; compute workers
# use the same diagnostic service with independent GP paths.
# 群阶分解界面使用的外部 PARI/GP 备选程序路径。Auto 默认先使用本地 PARI DLL；空值在需要 GP 时从 PATH
# 查找。此路径仅供 GUI 使用，计算 worker 使用相同诊断层，但 GP 路径独立设置。

# theme = "dark"  # string: [dark|light]
# Appearance mode, independent of legacy GUI settings.
# 外观模式，独立于旧 GUI 设置。

# display_language = "en"  # string: [en|zh]
# UI language; CJK font failure falls back to English.
# 界面语言；中文字体不可用时回退英文。

# language_file = ""  # string: <string, up to 255 bytes>
# Interface XML filename in localization/v2 beside the executable. Empty migrates the legacy en/zh
# selection. Companion options.*.xml files are not selectable interface files.
# 程序旁localization/v2目录中的界面XML文件名；空值按旧en/zh选择迁移。配套options.*.xml不是可选界面文
# 件。

# scale = 0  # float: [0..4]
# Zero selects window DPI; positive values select a fixed interface scale.
# 零按窗口 DPI 自动计算；正值指定界面比例。

# body_font_size = 15  # int: [10..30]
# Body and log font size in logical pixels, independently of interface DPI scale. Primary actions
# and secondary text apply their configured offsets; headings preserve their ratio.
# 正文与日志字号（逻辑像素），独立于界面 DPI 比例；主要操作与次要说明使用各自偏移，标题保持相对比
# 例。

# primary_font_offset = 1  # int: [0..6]
# Primary action font offset from the body size, in logical pixels; secondary buttons and log text
# keep the body size.
# 主要操作字号相对正文的偏移（逻辑像素）；次要按钮和日志正文保持正文字号。

# secondary_font_offset = -2  # int: [-6..0]
# Secondary text font offset from the body size, in logical pixels; the rendered role has a minimum
# of 8 logical pixels.
# 次要说明字号相对正文的偏移（逻辑像素）；实际字号最小为 8 逻辑像素。

# worker_chart_columns = 1  # int: [1|2]
# Curve-time chart columns: 1 for list, 2 for two charts per row; narrow workspaces temporarily use
# one column without changing the saved choice.
# 曲线耗时图列数：1为列表，2为每行两图；工作区过窄时临时使用单列，不改变保存的选择。

# gpu_history_seconds = 60  # int: [15|30|60|120]
# GPU chart time span in seconds, shared by all devices and persisted with UI preferences. Does not
# change the 500 ms sampling interval.
# GPU 图表时间范围（秒），所有设备共用并随界面偏好保存；不改变 500 ms 采样间隔。

# stage2_timing_source = "auto"  # string: [auto|previous|tune]
# Stage2 segment duration source: auto overlays previous completed-curve timings on tune data;
# previous or tune restricts the source. Missing durations are marked unknown.
# Stage2区段时长来源：auto按上次完成曲线覆盖tune数据；previous或tune仅使用指定来源，缺项明确标为未
# 知。

# stage2_timing_profile = ""  # string: <string, up to 4096 bytes>
# Optional read-only Stage2 tune summary path. Empty uses the workflow stage2_tune_profile, then
# tune.toml or stage2_ecm_tune.toml next to the workflow/worker. Relative paths use the workflow
# directory.
# 可选的只读Stage2 tune摘要路径。空值使用工作流stage2_tune_profile，再查找工作流/worker旁的tune.toml
# 或stage2_ecm_tune.toml；相对路径基于工作流目录。

# nav_order = "01237456"  # string: <string, up to 8 bytes>
# Stable page IDs 0..7; ID 5 opens Settings. Legacy seven-page orders append Group Order Factor
# without resetting the layout.
# 稳定页面编号0..7；5打开设置。旧七页排序追加群阶分解页，不重置布局。

# page = 0  # int: [0..7]
# Selected page: 0 workers, 1 results, 2 generator, 3 probability, 4 GPU, 6 components, 7 Group
# Order Factor; 5 opens Settings.
# 页面：0任务、1结果、2生成器、3概率、4 GPU、6组件、7群阶分解；5打开设置。

# selected_worker = 1  # int: [1..1024]
# Selected worker partition.
# 选中的 worker 分区。

# inspector = true  # bool: [false|true]
# Show the worker inspector on sufficiently wide windows.
# 宽窗口显示 worker 检查区。

# logs = true  # bool: [false|true]
# Enable logs in Workers management; automatic hiding on other views does not change this saved
# preference.
# 开启Workers管理页日志；其他视图的自动隐藏不改变此保存偏好。

# follow_log = true  # bool: [false|true]
# Follow new worker output.
# 跟随新的 worker 输出。

# raw_log = false  # bool: [false|true]
# Show raw output instead of classified event lines.
# 显示原始输出而非分类事件。

# workspace_layout = ""  # string: <string, up to 524288 bytes>
# Hex encoded ImGui layout; stored only in this sidecar.
# 十六进制编码的 ImGui 布局，仅存于本侧车。

# window_x = -2147483648  # int: [-2147483648..2147483647]
# Window x in physical pixels; INT_MIN selects system placement.
# 窗口物理像素 x；INT_MIN 由系统放置。

# window_y = -2147483648  # int: [-2147483648..2147483647]
# Window y in physical pixels; INT_MIN selects system placement.
# 窗口物理像素 y；INT_MIN 由系统放置。

# window_width = 1280  # int: [480..16384]
# Restored window width in physical pixels.
# 恢复窗口的物理像素宽度。

# window_height = 850  # int: [360..16384]
# Restored window height in physical pixels.
# 恢复窗口的物理像素高度。

# window_title_bar = false  # bool: [false|true]
# Show the system title bar; hidden by default with window controls in the app top bar. Explicit
# saved choices are retained.
# 显示系统标题栏；默认隐藏，窗口按钮位于应用顶栏；保留显式保存的选择。

# window_maximized = false  # bool: [false|true]
# Restore the maximized state.
# 恢复最大化状态。

# pet_enabled = false  # bool: [false|true]
# Show the ELYTerminal-compatible edge companion.
# 显示兼容 ELYTerminal 行为的窗口边缘宠物。

# pet_animate = true  # bool: [false|true]
# Animate at the existing GUI cadence; no extra render loop.
# 按既有 GUI 节奏动画，不另开渲染循环。

# pet_left = 72  # float: [0..16384]
# Companion offset from the main window left edge in logical units.
# 宠物相对主窗口左缘的逻辑单位偏移。

# pet_skin = "classic"  # string: [classic|miss_pink_elf|herrscher_of_human_ego|hi_love_elf]
# ELY appearance. Switches immediately; official battlesuit names are preserved in the selector.
# ELY 外观，即时切换；选择项使用装甲的完整英文名称。

# right_pages = 0  # int: [0..254]
# Real pages in the right dock share native horizontal tabs. Closing returns a page to navigation;
# one real page remains central. Settings bit 5 is cleared when opening old sidecars.
# 右侧实际页面共用横排标签，关闭后返回导航，至少保留一个实际中央页面；读取旧侧车时移除设置位5。

# right_page = 4  # int: [0..7]
# Last active real page in the right dock. Legacy Settings ID 5 is remapped on load.
# 右侧停靠区最后激活的实际页面；读取旧设置编号5时改选实际页面。

# right_visible = true  # bool: [false|true]
# Compatibility field retained for old sidecars. Right-side pages are always displayed; close their
# tabs to return them to navigation.
# 保留以读取旧侧车的兼容字段；右侧页面直接显示，关闭标签即可回到导航。

# smooth_scroll = true  # bool: [false|true]
# Smooth wheel scrolling in main and detached windows.
# 主窗口与分离窗口使用平滑滚轮滚动。

# toasts = true  # bool: [false|true]
# Show non-activating action notifications; errors always remain visible.
# 显示不抢焦点的操作轻提示；错误提示仍显示。

# external_windows = false  # bool: [false|true]
# Allow detached native panel windows after restart; default keeps docking and floating inside the
# main window to avoid the observed slow presentation path.
# 重启后允许原生独立面板窗；默认在主窗口内停靠/浮动，以规避已观察到的慢呈现路径。

# worker_chart_auto_y = false  # bool: [false|true]
# Fit curve-time Y bounds to finite samples in the current retained window; off keeps a zero
# baseline.
# 曲线耗时Y轴按当前保留窗口的有效样本自动缩放；关闭时从0开始。

# logs_keep_visible = false  # bool: [false|true]
# Keep enabled logs visible across pages; otherwise follow visible Workers management, with a
# temporary manual override on other views.
# 已开启日志跨页保持可见；关闭时跟随可见的Workers管理页，其他视图可临时手动打开。

# nav_collapsed = false  # bool: [false|true]
# Show only icons in the navigation sidebar.
# 将左侧导航缩为图标栏。

# nav_expanded_width = 0  # int: [0..16384]
# Previous expanded navigation width in logical pixels. Zero uses the default width.
# 上次展开的导航宽度，以逻辑像素计。0 使用默认宽度。

# nav_hide_tab_bar = true  # bool: [false|true]
# The Navigation tab bar starts hidden by default. The saved choice survives restarts and layout
# rebuilding.
# 导航顶部标签栏默认收起，保存的选择在重启及布局重建后保留。

# workspace_hide_tab_bar = true  # bool: [false|true]
# The Workspace tab bar starts hidden by default. The saved choice survives restarts and layout
# rebuilding.
# 工作区顶部标签栏默认收起，保存的选择在重启及布局重建后保留。

# right_hide_tab_bar = false  # bool: [false|true]
# Remember the right dock Hide tab bar choice. Multiple native tabs remain visible; the choice
# resumes when one remains.
# 持久记忆右侧停靠窗Hide tab bar选择；多个原生标签保持可见，恢复单标签时恢复该选择。

[worker.1]
# name = "Worker #{N}"  # string: <text>
# Worker display name in the GUI. Unset shows Worker #N, where N is the worker index. Changes only
# the name, not device or task assignment.
# 设置此 worker 在 GUI 中显示的名称。未配置时显示 Worker #N，其中 N 为 worker 编号；只改变显示名称，
# 不改变设备或任务分配。

# autostart = false  # bool: [false|true]
# Start this worker when the GUI opens. The setting applies to GUI startup.
# 设为 true 时，GUI 打开工作流后自动启动此 worker。

# extra_args = ""  # string: <argv>
# Command-line arguments common to both stages of this GUI-launched worker. Use the stage-specific
# keys for options that only one stage understands. Workflow configuration, worker number and queue
# path are managed by the GUI.
# 向 GUI 启动的 worker 追加两阶段共用的命令行参数。阶段专用选项使用对应的键。工作流配置、worker 编号
# 和队列路径由 GUI 管理。

# stage1_extra_args = ""  # string: <argv>
# Additional Stage1 command-line arguments appended after the common extra_args. Separate arguments
# with spaces and quote paths containing spaces.
# Stage1 专用命令行参数，追加在共用 extra_args 之后。参数以空格分隔，含空格的路径使用双引号。

# stage2_extra_args = ""  # string: <argv>
# Additional Stage2 command-line arguments appended after the common extra_args. Separate arguments
# with spaces and quote paths containing spaces.
# Stage2 专用命令行参数，追加在共用 extra_args 之后。参数以空格分隔，含空格的路径使用双引号。

# gpucurves = 0  # int: <x:Z,x>=0>
# Legacy GUI curve-count display field, inheriting the global value if present. Stage1 queue curve
# counts come from task lines; this field does not override them. The single-run -gpucurves CLI
# option is independent.
# 保留旧 GUI 配置的曲线数显示字段，可继承全局同名值。Stage1 队列执行的曲线数由各任务行决定，此键不会
# 覆盖任务；直接单次运行的 -gpucurves 是独立命令行参数。

# Worker 1 overrides / worker 1 覆盖
# queue_order = "stage1_first"
# stage1_gpu_device = 0
# stage2_gpu_device = 0
# tune_file = "tune_gpu0.toml"

# [worker.2]
# stage1_gpu_device = 1
# stage2_gpu_device = 1
# tune_file = "tune_gpu1.toml"

