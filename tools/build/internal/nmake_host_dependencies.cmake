# Probe with the same /utf-8 option as the project's host compile rules.
# CMake's cached compiler-ID probe may have used a different output encoding.
function(ecm_track_nmake_host_dependencies target)
    if(NOT MSVC OR NOT CMAKE_GENERATOR STREQUAL "NMake Makefiles")
        return()
    endif()
    include(CMakeDetermineCompilerId)
    foreach(_lang IN ITEMS C CXX)
        if(CMAKE_${_lang}_COMPILER_LOADED)
            CMAKE_DETERMINE_MSVC_SHOWINCLUDES_PREFIX(${_lang} "/utf-8")
            if(NOT CMAKE_${_lang}_CL_SHOWINCLUDES_PREFIX)
                message(FATAL_ERROR "Cannot detect MSVC ${_lang} /utf-8 include prefix")
            endif()
            set(CMAKE_${_lang}_CL_SHOWINCLUDES_PREFIX "${CMAKE_${_lang}_CL_SHOWINCLUDES_PREFIX}" PARENT_SCOPE)
        endif()
    endforeach()
    set(_ecm_host_depfile_stamp "${CMAKE_BINARY_DIR}/CMakeFiles/ecm-nmake-host-dependencies-utf8-v1")
    if(NOT EXISTS "${_ecm_host_depfile_stamp}")
        file(TOUCH "${_ecm_host_depfile_stamp}")
    endif()
    get_target_property(_sources "${target}" SOURCES)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES [[\.(c|cc|cpp|cxx)$]])
            set_property(SOURCE "${_source}" APPEND PROPERTY OBJECT_DEPENDS "${_ecm_host_depfile_stamp}")
        endif()
    endforeach()
endfunction()
