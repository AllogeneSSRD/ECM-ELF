file(READ "${ECM_GUI_V2_ROOT}/config/gui_v2_state.generated.json" _ui_json)
string(JSON _ui_count LENGTH "${_ui_json}" sha256)
math(EXPR _ui_last "${_ui_count}-1")
foreach(_ui_i RANGE 0 ${_ui_last})
    string(JSON _ui_name MEMBER "${_ui_json}" sha256 ${_ui_i})
    string(JSON _ui_expected GET "${_ui_json}" sha256 "${_ui_name}")
    file(SHA256 "${ECM_GUI_V2_ROOT}/${_ui_name}" _ui_actual)
    if(NOT _ui_actual STREQUAL _ui_expected)
        message(FATAL_ERROR "Stale GUI v2 sidecar: ${_ui_name}; run python tools/gen/generate_gui_v2_state.py")
    endif()
endforeach()

file(READ "${ECM_GUI_V2_ROOT}/config/gui_v2_pet_skins.generated.json" _skin_json)
string(JSON _skin_count LENGTH "${_skin_json}" sha256)
math(EXPR _skin_last "${_skin_count}-1")
foreach(_skin_i RANGE 0 ${_skin_last})
    string(JSON _skin_name MEMBER "${_skin_json}" sha256 ${_skin_i})
    string(JSON _skin_expected GET "${_skin_json}" sha256 "${_skin_name}")
    file(SHA256 "${ECM_GUI_V2_ROOT}/${_skin_name}" _skin_actual)
    if(NOT _skin_actual STREQUAL _skin_expected)
        message(FATAL_ERROR "Stale GUI v2 pet skin: ${_skin_name}; regenerate skins and their fingerprint receipt")
    endif()
endforeach()
