# One interpretation of Stage1 tier input for CMake, generators and build profiles.
function(ecm_stage1_normalize_tiers raw output)
    get_filename_component(_repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
    file(STRINGS "${_repo}/src/ecm/cuda/dispatch/tiers.def" _rows REGEX "^ECM_CUDA_TIER\\([0-9]+,")
    set(_known "")
    foreach(_row IN LISTS _rows)
        string(REGEX MATCH "^ECM_CUDA_TIER\\(([0-9]+)," _match "${_row}")
        list(APPEND _known "${CMAKE_MATCH_1}")
    endforeach()
    list(JOIN _known ", " _allowed)
    string(STRIP "${raw}" _input)
    if(_input STREQUAL "")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(_input MATCHES ";")
        message(FATAL_ERROR "Invalid ECM_TIERS value '${raw}': use commas, not ';'. Allowed widths: ${_allowed}")
    endif()
    string(REPLACE "," ";" _items "${_input}")
    set(_selected "")
    foreach(_item IN LISTS _items)
        string(STRIP "${_item}" _item)
        if(NOT _item IN_LIST _known)
            message(FATAL_ERROR "Invalid ECM_TIERS item '${_item}' in '${raw}'. Allowed widths: ${_allowed}; an empty value selects all widths")
        endif()
        list(APPEND _selected "${_item}")
    endforeach()
    # Inventory order is canonical: whitespace, duplicates and input order do not
    # manufacture different profiles for the same set of compiled instances.
    set(_normalized "")
    foreach(_width IN LISTS _known)
        if(_width IN_LIST _selected)
            list(APPEND _normalized "${_width}")
        endif()
    endforeach()
    list(JOIN _normalized "," _normalized)
    set(${output} "${_normalized}" PARENT_SCOPE)
endfunction()

# Read-only entry used before PowerShell constructs its configuration identity.
if(ECM_STAGE1_TIERS_QUERY)
    cmake_minimum_required(VERSION 3.20)
    ecm_stage1_normalize_tiers("${ECM_TIERS}" _normalized)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "ECM_STAGE1_TIERS=${_normalized}")
endif()
