include("${CMAKE_CURRENT_LIST_DIR}/ecm_libecm.cmake")
file(READ "${ECM_LIBECM_SOURCE_DIR}/ecm-ecm.h" _ecm_internal_header)
string(REGEX MATCH "#define NTT_SIZE_THRESHOLD +([0-9]+)" _ecm_ntt_match "${_ecm_internal_header}")
if(NOT _ecm_ntt_match)
    message(FATAL_ERROR "Cannot read GMP-ECM NTT limb threshold")
endif()
set(_ecm_ntt_threshold "${CMAKE_MATCH_1}")
get_filename_component(_ecm_repo "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
execute_process(COMMAND git rev-parse --short=12 HEAD WORKING_DIRECTORY "${_ecm_repo}"
    OUTPUT_VARIABLE _ecm_build_id OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _ecm_build_id)
    set(_ecm_build_id development)
endif()
file(SHA256 "${_ecm_repo}/src/core/ecm_cpu_stage2_main.cpp" _ecm_source_id)
string(SUBSTRING "${_ecm_source_id}" 0 12 _ecm_source_id)
string(APPEND _ecm_build_id ".cpu-s2.${_ecm_source_id}")
add_executable(ecm_cpu_stage2 "${_ecm_repo}/src/core/ecm_cpu_stage2_main.cpp"
    "${_ecm_repo}/src/core/ecm_stage1_checkpoint_runtime.cpp")
target_compile_features(ecm_cpu_stage2 PRIVATE cxx_std_17)
target_compile_definitions(ecm_cpu_stage2 PRIVATE _CRT_SECURE_NO_WARNINGS "ECM_BUILD_ID=\"${_ecm_build_id}\"" "ECM_LIBECM_NTT_THRESHOLD=${_ecm_ntt_threshold}")
target_link_libraries(ecm_cpu_stage2 PRIVATE ecm_cpu_library)
target_compile_options(ecm_cpu_stage2 PRIVATE /O2 /MD /openmp)
