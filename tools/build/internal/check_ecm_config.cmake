# Native build guard; generated sources require no Python at build/run time.
if(NOT DEFINED ECM_CONFIG_ROOT)
    get_filename_component(ECM_CONFIG_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
endif()
set(_ecm_manifest "${ECM_CONFIG_ROOT}/config/ecm_config.generated.json")
if(NOT EXISTS "${_ecm_manifest}")
    message(FATAL_ERROR "Missing generated config. Run: python tools/gen/generate_ecm_config.py")
endif()
file(READ "${_ecm_manifest}" _ecm_json)
string(JSON _ecm_count LENGTH "${_ecm_json}" sha256)
math(EXPR _ecm_last "${_ecm_count}-1")
foreach(_ecm_i RANGE 0 ${_ecm_last})
    string(JSON _ecm_name MEMBER "${_ecm_json}" sha256 ${_ecm_i})
    string(JSON _ecm_expected GET "${_ecm_json}" sha256 "${_ecm_name}")
    if(NOT EXISTS "${ECM_CONFIG_ROOT}/${_ecm_name}")
        message(FATAL_ERROR "Missing generated config input/output: ${_ecm_name}; run python tools/gen/generate_ecm_config.py")
    endif()
    file(SHA256 "${ECM_CONFIG_ROOT}/${_ecm_name}" _ecm_actual)
    if(NOT _ecm_actual STREQUAL _ecm_expected)
        message(FATAL_ERROR "Stale config: ${_ecm_name}; run python tools/gen/generate_ecm_config.py")
    endif()
endforeach()
