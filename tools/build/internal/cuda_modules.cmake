# Derive one Stage1 fatbin per curve/parameterization/container from tiers.def.
# Generated files are content-stable and participate in the normal target closure.
function(ecm_stage1_isolate_modules)
    set(_dir "${CMAKE_BINARY_DIR}/cuda_modules/stage1")
    file(MAKE_DIRECTORY "${_dir}")
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/ecm/cuda/dispatch/tiers.def" _rows REGEX "^ECM_CUDA_TIER\\([0-9]+,")
    set(_sources "${ECM_STAGE1_CUDA_SOURCES}")
    list(FILTER _sources EXCLUDE REGEX "/instances/[^/]+\\.cu$")
    foreach(_row IN LISTS _rows)
        string(REGEX MATCH "ECM_CUDA_TIER\\(([0-9]+),([0-9]+),([0-9]+),([01])," _match "${_row}")
        set(_bits "${CMAKE_MATCH_1}")
        set(_mont "${CMAKE_MATCH_4}")
        if(DEFINED ECM_TIERS AND NOT ECM_TIERS STREQUAL "")
            string(REPLACE "," ";" _selected "${ECM_TIERS}")
            if(NOT _bits IN_LIST _selected)
                continue()
            endif()
        endif()
        set(_ed "#define ECM_CUDA_TIER_MIN_BITS ${_bits}\n#define ECM_CUDA_TIER_MAX_BITS ${_bits}\n#include \"${CMAKE_SOURCE_DIR}/src/ecm/stage1/edwards/cuda/instances/instances.cuh\"\n")
        set(_file "${_dir}/edwards_${_bits}.cu")
        ecm_write_stable("${_file}" "${_ed}")
        list(APPEND _sources "${_file}")
        if(_mont)
            foreach(_param 0 2 3)
                set(_file "${_dir}/mont${_param}_${_bits}.cu")
                ecm_write_stable("${_file}" "#define ECM_MONT_PARAM ${_param}\n#define ECM_CUDA_TIER_MIN_BITS ${_bits}\n#define ECM_CUDA_TIER_MAX_BITS ${_bits}\n#define ECM_MONT_FACTORY ecm_mont_param${_param}_w${_bits}\n#include \"${CMAKE_SOURCE_DIR}/src/ecm/stage1/montgomery/cuda/instances/instances.cuh\"\n")
                list(APPEND _sources "${_file}")
                # NVCC before 12.6 has no per-kernel __maxnreg__ attribute.
                # An isolated TU contains just this parameterization and tier.
                if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 12.6)
                    if(_bits LESS_EQUAL 2048)
                        set(_registers 56)
                    elseif(_bits LESS_EQUAL 5120)
                        set(_registers 128)
                    else()
                        set(_registers 255)
                    endif()
                    set_source_files_properties("${_file}" PROPERTIES COMPILE_OPTIONS "--maxrregcount=${_registers}")
                endif()
            endforeach()
        endif()
    endforeach()
    set(ECM_STAGE1_CUDA_SOURCES "${_sources}" PARENT_SCOPE)
endfunction()

function(ecm_write_stable path content)
    if(EXISTS "${path}")
        file(READ "${path}" _old)
        if(_old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()
