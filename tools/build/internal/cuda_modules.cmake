# Derive one Stage1 fatbin per curve/parameterization/container from tiers.def.
# Generated files are content-stable and participate in the normal target closure.
include("${CMAKE_CURRENT_LIST_DIR}/stage1_tiers.cmake")
function(ecm_stage1_generate_modules)
    ecm_stage1_normalize_tiers("${ECM_TIERS}" ECM_TIERS)
    # Standalone probes pass native Windows paths; catalog paths must be valid JSON.
    file(TO_CMAKE_PATH "${CMAKE_BINARY_DIR}" _binary_dir)
    set(_dir "${_binary_dir}/cuda_modules/stage1")
    file(MAKE_DIRECTORY "${_dir}")
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/ecm/cuda/dispatch/tiers.def" _rows REGEX "^ECM_CUDA_TIER\\([0-9]+,")
    set(_sources "${ECM_STAGE1_CUDA_SOURCES}")
    set(_prac_sources "${ECM_STAGE1_PRAC_SOURCES}")
    set(_prac_dispatch "// Generated from the active Stage1 instance inventory.\n")
    set(_eligible_mont "")
    set(_records "")
    set(_separator "")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/src/ecm/cuda/dispatch/tiers.def")
    endif()
    foreach(_row IN LISTS _rows)
        string(REGEX MATCH "ECM_CUDA_TIER\\(([0-9]+),([0-9]+),([0-9]+),([01]),([01])," _match "${_row}")
        set(_bits "${CMAKE_MATCH_1}")
        set(_tpi "${CMAKE_MATCH_2}")
        set(_mont "${CMAKE_MATCH_4}")
        set(_dev "${CMAKE_MATCH_5}")
        if(DEFINED ECM_TIERS AND NOT ECM_TIERS STREQUAL "")
            string(REPLACE "," ";" _selected "${ECM_TIERS}")
            if(NOT _bits IN_LIST _selected)
                continue()
            endif()
        endif()
        set(_ed "#define ECM_CUDA_TIER_MIN_BITS ${_bits}\n#define ECM_CUDA_TIER_MAX_BITS ${_bits}\n#include \"${CMAKE_SOURCE_DIR}/src/ecm/stage1/edwards/cuda/instances/instances.cuh\"\n")
        set(_file "${_dir}/edwards_${_bits}.cu")
        ecm_write_stable("${_file}" "${_ed}")
        list(APPEND _sources "${_file}")
        ecm_stage1_record_module("edwards_${_bits}" edwards -1 ${_bits} ${_tpi} binary_naf 0)
        if(_mont AND (ECM_CUDA_FULL_BUILD OR _dev))
            foreach(_param 0 2 3)
                if(_param EQUAL 2 AND ECM_NO_PARAM2)
                    continue()
                endif()
                set(_file "${_dir}/mont${_param}_${_bits}.cu")
                ecm_write_stable("${_file}" "#define ECM_MONT_PARAM ${_param}\n#define ECM_CUDA_TIER_MIN_BITS ${_bits}\n#define ECM_CUDA_TIER_MAX_BITS ${_bits}\n#define ECM_MONT_FACTORY ecm_mont_param${_param}_w${_bits}\n#include \"${CMAKE_SOURCE_DIR}/src/ecm/stage1/montgomery/cuda/instances/instances.cuh\"\n")
                list(APPEND _sources "${_file}")
                # NVCC before 12.6 has no per-kernel __maxnreg__ attribute.
                # An isolated TU contains just this parameterization and tier.
                set(_registers 0)
                if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 12.6)
                    if(_bits LESS_EQUAL 2048)
                        set(_registers 56)
                    elseif(_bits LESS_EQUAL 5120)
                        set(_registers 128)
                    else()
                        set(_registers 255)
                    endif()
                    if(NOT CMAKE_SCRIPT_MODE_FILE)
                        set_source_files_properties("${_file}" PROPERTIES COMPILE_OPTIONS "--maxrregcount=${_registers}")
                    endif()
                endif()
                ecm_stage1_record_module("mont${_param}_${_bits}" montgomery ${_param} ${_bits} ${_tpi} ladder ${_registers})
            endforeach()
            if(ECM_CUDA_ENABLE_PRAC)
                list(APPEND _eligible_mont "${_bits}")
                set(_modes "0,1,2,3")
                if(_bits GREATER 2048 AND _bits LESS_EQUAL 8192)
                    string(APPEND _modes ",4")
                endif()
                if(_bits EQUAL 4608 AND _tpi EQUAL 16)
                    string(APPEND _modes ",5,6,7,8,9")
                endif()
                ecm_stage1_prac_instance(standard ${_bits} ${_tpi} "${_modes}")
            endif()
        endif()
    endforeach()
    if(ECM_CUDA_ENABLE_PRAC)
        file(STRINGS "${CMAKE_SOURCE_DIR}/src/ecm/cuda/dispatch/tiers.def" _variants REGEX "^ECM_CUDA_PRAC_VARIANT\\(")
        foreach(_row IN LISTS _variants)
            string(REGEX MATCH "^ECM_CUDA_PRAC_VARIANT\\(([0-9]+),([0-9]+),([a-z_]+)\\)" _match "${_row}")
            set(_bits "${CMAKE_MATCH_1}")
            set(_tpi "${CMAKE_MATCH_2}")
            set(_family "${CMAKE_MATCH_3}")
            if(NOT _bits IN_LIST _eligible_mont)
                continue()
            endif()
            if(_family STREQUAL "alternate")
                ecm_stage1_prac_instance(alternate ${_bits} ${_tpi} "0,1,2,3,4")
            elseif(_family STREQUAL "single")
                if(_tpi EQUAL 16)
                    ecm_stage1_prac_instance(single ${_bits} ${_tpi} "10,11,12,13,14")
                else()
                    ecm_stage1_prac_instance(single ${_bits} ${_tpi} "12,13")
                endif()
            elseif(_family STREQUAL "constants")
                ecm_stage1_prac_instance(constants ${_bits} ${_tpi} "15,16,17")
            else()
                message(FATAL_ERROR "Unknown PRAC instance family '${_family}' in tiers.def")
            endif()
        endforeach()
    endif()
    ecm_write_stable("${_dir}/stage1_prac_instances.inc" "${_prac_dispatch}")
    ecm_write_stable("${_dir}/modules.json" "{\n  \"schema\": 1,\n  \"tiers\": \"${ECM_TIERS}\",\n  \"modules\": [${_records}\n  ]\n}\n")
    set(ECM_STAGE1_CUDA_SOURCES "${_sources}" PARENT_SCOPE)
    set(ECM_STAGE1_PRAC_SOURCES "${_prac_sources}" PARENT_SCOPE)
    set(ECM_TIERS "${ECM_TIERS}" PARENT_SCOPE)
endfunction()

function(ecm_stage1_record_module label curve param bits tpi family registers)
    string(APPEND _records "${_separator}\n    {\"label\":\"${label}\",\"source\":\"${_file}\",\"curve\":\"${curve}\",\"param\":${param},\"bits\":${bits},\"tpi\":${tpi},\"family\":\"${family}\",\"maxrregcount\":${registers},\"modes\":[${ARGV7}]}")
    set(_records "${_records}" PARENT_SCOPE)
    set(_separator "," PARENT_SCOPE)
endfunction()

macro(ecm_stage1_prac_instance family bits tpi modes)
    set(_label "prac_${family}_${bits}_tpi${tpi}")
    set(_factory "ecm_${_label}")
    set(_file "${_dir}/${_label}.cu")
    set(_template "instances.cuh")
    if("${family}" STREQUAL "single")
        set(_template "single_instances.cuh")
    elseif("${family}" STREQUAL "constants")
        set(_template "constants.cuh")
    endif()
    ecm_write_stable("${_file}" "#define ECM_PRAC_BITS ${bits}\n#define ECM_PRAC_TPI ${tpi}\n#define ECM_PRAC_FACTORY ${_factory}\n#include \"${CMAKE_SOURCE_DIR}/src/ecm/stage1/montgomery/cuda/prac/${_template}\"\n")
    list(APPEND _prac_sources "${_file}")
    string(APPEND _prac_dispatch "ECM_STAGE1_PRAC_INSTANCE(${family},${bits},${tpi},${_factory})\n")
    # PRAC keeps its existing per-kernel attributes. Older toolkits historically
    # erased them; do not silently introduce a different per-TU cap policy here.
    ecm_stage1_record_module("${_label}" montgomery 0 ${bits} ${tpi} "prac_${family}" 0 "${modes}")
endmacro()

function(ecm_write_stable path content)
    if(EXISTS "${path}")
        file(READ "${path}" _old)
        if(_old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

# Independent probes share the production generator without configuring CUDA.
if(DEFINED ECM_STAGE1_MODULES_OUTPUT)
    cmake_minimum_required(VERSION 3.20)
    get_filename_component(CMAKE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    set(CMAKE_BINARY_DIR "${ECM_STAGE1_MODULES_OUTPUT}")
    include("${CMAKE_CURRENT_LIST_DIR}/cuda_sources.cmake")
    ecm_stage1_generate_modules()
endif()
